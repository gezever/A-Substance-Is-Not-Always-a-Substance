        skos:notation    "CHEMONTID:0003410";
        skos:prefLabel   "1-benzopyrans"@en .

CHEMONTID:0002273  rdf:type  skos:Concept;
        skos:altLabel    "imidazolidine-2,4-dione" , " Imidazolidine-2,4-diones" , "an  imidazolidine-2,4-dione";
        skos:broader     CHEMONTID:0001150;
