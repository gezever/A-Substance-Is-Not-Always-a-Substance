        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000085";
        skos:prefLabel   "Phosphinines"@en .

CHEMONTID:0001358  rdf:type  skos:Concept;
        skos:altLabel    "phosphatidylglycerol" , "Diacylglycerophosphoglycerols" , "Phosphatidylglycerol";
        skos:broader     CHEMONTID:0002216;
