        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0000310;
        skos:notation    "CHEMONTID:0000309";
        skos:prefLabel   "Benzothiazines"@en .

CHEMONTID:0001956  rdf:type  skos:Concept;
        skos:altLabel    "amide";
        skos:broader     CHEMONTID:0001813;
