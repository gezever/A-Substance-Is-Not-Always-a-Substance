        skos:broader     CHEMONTID:0004445;
        skos:definition  "Organoheterosilanes with the general structure RSi(ON=CMeEt)3, where R is an organyl group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004609";
        skos:prefLabel   "Tris(ketoximino)silanes"@en .

CHEMONTID:0004394  rdf:type  skos:Concept;
