        skos:broader     CHEMONTID:0000274;
        skos:definition  "Compounds containing a pyrroloacridine moiety, which is a tetracyclic heterocycle which consists of a pyrrole ring fused to an acridine.";
        skos:inScheme    conceptscheme:chemical_substance;
