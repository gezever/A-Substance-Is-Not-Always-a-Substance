CHEMONTID:0003589  rdf:type  skos:Concept;
        skos:altLabel    "a pyrazoimidazole" , "Pyrazoimidazoles" , "an imidazopyrazine" , "imidazopyrazine";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Organic heteropolycyclic compounds containing a pyrazine ring fused to an imidazole ring. These also include hydrogenated derivatives of the imidazopyrazine moiety. Imidazole is 5-membered ring consisting of three carbon atoms, and two nitrogen centers at the 1- and 3-positions. Pyrazine is a 6-membered ring consisting of six carbon atoms and two nitrogen centers at ring positions 1 and 4.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003589";
        skos:prefLabel   "Imidazopyrazines"@en .

CHEMONTID:0003734  rdf:type  skos:Concept;
