        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003521";
        skos:prefLabel   "Pyranoxanthones"@en .

CHEMONTID:0000204  rdf:type  skos:Concept;
        skos:altLabel    "Dibenzofurans, griseofulvins, dibenzopyrans and xanthones" , "xanthones";
        skos:broader     CHEMONTID:0000200;
