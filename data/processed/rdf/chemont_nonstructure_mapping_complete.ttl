CHEMONTID:0002119  rdf:type  skos:Concept;
        skos:altLabel    "quassinoid";
        skos:broader     CHEMONTID:0001283;
        skos:definition  "A group of compounds chemically degraded from triterpenes. According to their basic skeleton, quassinoids are categorized into five distinct groups, C-18, C-19, C-20, C-22 and C-25 types. The C-20 quassinoids can be further classified into two types, tetracyclic and the pentacyclic. The tetracyclic variety does not have oxygenation at C-20, while the pentacyclic quassinoids possess additional oxygenation at C-20 that allows for the formation of an additional ring.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002119";
        skos:prefLabel   "Quassinoids"@en .

CHEMONTID:0003374  rdf:type  skos:Concept;
        skos:altLabel    "dithiolanes" , "carboxylic acid";
        skos:broader     CHEMONTID:0003379;
        skos:definition  "Organic compounds containing a 1,2-dithiolane ring that bears a carboxylic acid group at the 3-position.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003374";
        skos:prefLabel   "1,2-dithiolane-3-carboxylic acids"@en .

CHEMONTID:0004706  rdf:type  skos:Concept;
        skos:altLabel    "triazines";
        skos:broader     CHEMONTID:0000490;
        skos:definition  "Aromatic heterocyclic compounds containing a s-triazine ring which is substituted with a urea at the ring 2-position.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004706";
