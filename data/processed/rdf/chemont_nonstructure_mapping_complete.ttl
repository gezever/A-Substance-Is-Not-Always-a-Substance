        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0002085 , CHEMONTID:0002413;
        skos:notation    "CHEMONTID:0002265";
        skos:prefLabel   "Pyrazine carboxylic acids and derivatives"@en .

CHEMONTID:0001018  rdf:type  skos:Concept;
