CHEMONTID:0003869  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000408;
        skos:definition  "Organophosphorus compounds containing a monoamide derivative of a phosphoric acid diester functional group. They have the general structure R1OP(=O)(OR2)N(R3)R4, where R1-R2 = organyl group and R3-R4 = H or organyl.";
        skos:inScheme    conceptscheme:chemical_substance;
