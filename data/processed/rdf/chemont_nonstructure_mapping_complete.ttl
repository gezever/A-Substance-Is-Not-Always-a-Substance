        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004640";
        skos:prefLabel   "Phenyl methylcarbamates"@en .

CHEMONTID:0001656  rdf:type  skos:Concept;
        skos:altLabel    "acetal";
        skos:broader     CHEMONTID:0000254;
        skos:definition  "Compounds having the structure R2C(OR')2 ( R' not Hydrogen) and thus diethers of geminal diols. Originally, the term was confined to derivatives of aldehydes (one R = H), but it now applies equally to derivatives of ketones (neither R = H ). Mixed acetals have different R' groups.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004472;
        skos:notation    "CHEMONTID:0001656";
        skos:prefLabel   "Acetals"@en .

