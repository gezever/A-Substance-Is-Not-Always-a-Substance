        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001018";
        skos:prefLabel   "Inorganic cyanides"@en .

CHEMONTID:0000084  rdf:type  skos:Concept;
        skos:altLabel    "oxazole";
        skos:broader     CHEMONTID:0002490;
