        skos:definition  "Organic compounds containing a nitrate that is O-linked to an alkyl group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004091";
        skos:prefLabel   "Alkyl nitrates"@en .

CHEMONTID:0003665  rdf:type  skos:Concept;
