        skos:broader     CHEMONTID:0001355;
        skos:definition  "Glycerophosphoinositols where the glycerol is acylated only at position O-1 with a fatty acid.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002101";
