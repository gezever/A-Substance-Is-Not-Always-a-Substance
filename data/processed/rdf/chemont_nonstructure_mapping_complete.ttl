CHEMONTID:0002723  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0002719;
        skos:definition  "Lupin alkaloids with a structure based on the anagyrine skeleton. Anagyrine is a tetracyclic ketone containing a quinolizidine, and two pyridine rings fused together to form dipyrido[1,2-a:1',2'-e][1,5]diazocin-4-one.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002723";
