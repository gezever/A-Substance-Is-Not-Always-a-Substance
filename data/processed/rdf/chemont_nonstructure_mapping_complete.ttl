CHEMONTID:0001706  rdf:type  skos:Concept;
        skos:altLabel    "phenols" , "monomethoxybenzene" , "glycol";
        skos:broader     CHEMONTID:0000190;
        skos:definition  "Compounds containing a gingerdiol moiety, which is structurally characterized by a 4-hydroxy-3-methoxyphenyl group substituted at the C6 carbon atom by an alkane-2,4-diol.";
        skos:inScheme    conceptscheme:chemical_substance;
