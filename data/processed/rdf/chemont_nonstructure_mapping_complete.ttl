        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001868";
        skos:prefLabel   "Indazole ribonucleosides and ribonucleotides"@en .

CHEMONTID:0002884  rdf:type  skos:Concept;
