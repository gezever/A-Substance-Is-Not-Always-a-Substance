        skos:notation    "CHEMONTID:0001762";
        skos:prefLabel   "Pyrroloacridines"@en .

CHEMONTID:0001080  rdf:type  skos:Concept;
        skos:altLabel    "tetrazoles";
        skos:broader     CHEMONTID:0002490;
        skos:definition  "Organic compounds containing a tetrazoline ring, which is a five-member unsaturated aliphatic heterocycle made up of four nitrogen atoms, a one carbon atom, and one double bond.";
        skos:inScheme    conceptscheme:chemical_substance;
