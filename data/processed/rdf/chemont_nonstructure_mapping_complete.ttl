CHEMONTID:0003018  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000279;
        skos:definition  "Alkaloids with a structure that contains the isoaporphine skeleton. Isoaporphine is an isomer of aporphine, with the difference that the N atom of the quinoline moiety is at the 1-position instead of the 6-position. This compounds also include oxoisoaporphines, which bear an oxo group at the 7-position. Oxoisoaporphines are believed to arise from aporphines via a spirodienone rearrangement.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004118;
        skos:notation    "CHEMONTID:0003018";
        skos:prefLabel   "Isoaporphines"@en .

