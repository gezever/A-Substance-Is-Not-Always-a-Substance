        skos:altLabel    "Nitro fatty acids" , "fatty acid" , "C-nitro compound";
        skos:broader     CHEMONTID:0000262;
        skos:definition  "Fatty acids containing a nitro group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000471";
        skos:prefLabel   "Nitro fatty acids"@en .

CHEMONTID:0004618  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0004616;
        skos:definition  "Aryl phosphates in which the phosphate is esterified at exactly two positions.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004618";
        skos:prefLabel   "Aryl phosphodiesters"@en .

CHEMONTID:0003125  rdf:type  skos:Concept;
        skos:altLabel    "organonitrogen compound";
        skos:broader     CHEMONTID:0000278;
        skos:definition  "Organic compounds with the general formula N=C(R)R' (R=organyl, R' = H or organyl).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003125";
        skos:prefLabel   "Imidocarbonyl compounds"@en .

CHEMONTID:0000645  rdf:type  skos:Concept;
        skos:altLabel    "inorganic nitrate salt" , "alkali metal salt";
        skos:broader     CHEMONTID:0000445;
        skos:definition  "Inorganic compounds in which the largest oxoanion is nitrate, and in which the heaviest atom not in an oxoanion is an alkali metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000645";
        skos:prefLabel   "Alkali metal nitrates"@en .

CHEMONTID:0000921  rdf:type  skos:Concept;
        skos:altLabel    "alkaline earth salt";
        skos:broader     CHEMONTID:0000446;
        skos:definition  "Inorganic compounds in which the largest oxoanion is silicate, and in which the heaviest atom not in an oxoanion is an alkaline earth metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000921";
        skos:prefLabel   "Alkaline earth metal silicates"@en .

CHEMONTID:0004160  rdf:type  skos:Concept;
        skos:altLabel    "haloforms" , "a trihalomethane" , "Trihalomethanes";
        skos:broader     CHEMONTID:0004157;
        skos:definition  "Organic compounds in which exactly three of the four hydrogen atoms of methane (CH4) are replaced by halogen atoms.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004160";
        skos:prefLabel   "Trihalomethanes"@en .

CHEMONTID:0001818  rdf:type  skos:Concept;
        skos:altLabel    "furopyran";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Organic polycyclic compounds containing a furan ring fused to a pyran ring. Furan is a five-membered aromatic ring with four carbon atoms and one oxygen atom. Pyran a six-membered heterocyclic, non-aromatic ring, made up of five carbon atoms and one oxygen atom and containing two double bonds.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001818";
        skos:prefLabel   "Furopyrans"@en .

CHEMONTID:0000582  rdf:type  skos:Concept;
        skos:altLabel    "Inorganic Chemicals" , "inorganic salt" , "bromide salt" , "Metalloids";
        skos:broader     CHEMONTID:0000442;
        skos:definition  "Inorganic compounds in which the largest halogen atom is Bromine, and the heaviest metal atom a metalloid.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000582";
        skos:prefLabel   "Metalloid bromides"@en .

CHEMONTID:0003906  rdf:type  skos:Concept;
        skos:altLabel    "organofluorine compound" , "<new synonym>";
        skos:broader     CHEMONTID:0003903;
        skos:definition  "Compounds derived from an alkene by replacing a hydrogen atom with a fluorine atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003906";
        skos:prefLabel   "Fluoroalkenes"@en .

CHEMONTID:0001684  rdf:type  skos:Concept;
        skos:altLabel    "glycerophospholipid";
        skos:broader     CHEMONTID:0001683;
        skos:definition  "Monacylglyerophosphates in which the glycerol moiety is esterified at position 1 and attached to a phosphate group through the O-2 atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001684";
        skos:prefLabel   "1-acylglycerol-2-phosphates"@en .

CHEMONTID:0001768  rdf:type  skos:Concept;
        skos:altLabel    "Ginkgolides and Bilobalides" , "diterpene lactone";
        skos:broader     CHEMONTID:0001538;
        skos:definition  "Diterpene lactones with a structure based either on the gingkolide or the bilobalide skeleton. The ginkgolide skeleton is a very rigid structure consisting of hexacyclic C20 trilactone. The cis-fused F/A/D/C ring junction forms an empty semi-ball hole, the D ring contains a cage form tetrahydrofuran ring which occupies the center of the empty hole, and the oxygen atoms of the D,C and F ring and 10-hydroxyl group consist of an analogous crown ether structure.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001768";
        skos:prefLabel   "Ginkgolides and bilobalides"@en .

CHEMONTID:0004408  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0004407;
        skos:definition  "Aromatic compounds containing a furopyridine ring system, where the O- and the N-atom are at the 1- and 6- position, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004408";
        skos:prefLabel   "Furo[2,3-c]pyridines"@en .

CHEMONTID:0003058  rdf:type  skos:Concept;
        skos:altLabel    "20-oxo steroid";
        skos:broader     CHEMONTID:0001194;
        skos:definition  "Steroid derivatives carrying a C=O group at the 20-position of the steroid skeleton.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003058";
        skos:prefLabel   "20-oxosteroids"@en .

CHEMONTID:0004733  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0003080;
        skos:definition  "Aromatic heterocyclic compounds containing a S-triazine ring, which is N-substituted at the 2-position with a benzylamine.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004733";
        skos:prefLabel   "2-benzylamino-s-triazines"@en .

CHEMONTID:0000166  rdf:type  skos:Concept;
        skos:altLabel    "thiocarboxamide";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Cyclic thioamides, obtained by replacing the oxygen atom from a lactam ring with sulfur.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000166";
        skos:prefLabel   "Thiolactams"@en .

CHEMONTID:0003498  rdf:type  skos:Concept;
        skos:altLabel    "glycoside" , "benzofurans";
        skos:broader     CHEMONTID:0002207;
        skos:definition  "Benzofurans that a O-glycosylated at the 2-position. Benzofurans are organic compounds containing a benzene ring fused to a furan.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003498";
        skos:prefLabel   "Benzofuran-2-O-glycosides"@en .

CHEMONTID:0004264  rdf:type  skos:Concept;
        skos:altLabel    "1-phosphatidyl-1D-myo-inositol 3,4,5-trisphosphate";
        skos:broader     CHEMONTID:0004254;
        skos:definition  "Lipids containing a myo-inositol-3,4,5-bisphosphate attached to the phosphate group of a glycerol-3-phosphate moiety, and two acyl chains linked to the glycerol at the O1- and O2- positions, through ester linkages.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004264";
        skos:prefLabel   "1-phosphatidyl-1D-myo-inositol-3,4,5-trisphosphates"@en .

CHEMONTID:0000634  rdf:type  skos:Concept;
        skos:altLabel    "alkali metal salt";
        skos:broader     CHEMONTID:0000445;
        skos:definition  "Inorganic compounds in which the largest oxoanion is chromate, and in which the heaviest atom is an alkali metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000634";
        skos:prefLabel   "Alkali metal chromates"@en .

CHEMONTID:0001788  rdf:type  skos:Concept;
        skos:altLabel    "macrolide" , "resorcinols";
        skos:broader     CHEMONTID:0000147;
        skos:definition  "Macrolides which contains a fourteen-member lactone fused to 1,3-dihydroxybenzene.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001788";
        skos:prefLabel   "Zearalenones"@en .

CHEMONTID:0002239  rdf:type  skos:Concept;
        skos:altLabel    "a trialkylamine" , "tertiary amino compound";
        skos:broader     CHEMONTID:0002452;
        skos:definition  "Organic compounds containing a trialkylamine group, characterized by exactly three alkyl groups bonded to the amino nitrogen.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002239";
        skos:prefLabel   "Trialkylamines"@en .

CHEMONTID:0003994  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000419;
        skos:definition  "Organic derivatives of phosphonic acid having the general formula RP(=O)(NHNH2)2, where the R is an organyl group and the hydrogen atoms can be replaced by an organyl group.";
        skos:inScheme    conceptscheme:chemical_substance;
