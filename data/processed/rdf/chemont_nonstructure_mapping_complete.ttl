        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002176";
        skos:prefLabel   "Purine deoxyribonucleoside 2',5'-bisphosphates"@en .

CHEMONTID:0002173  rdf:type  skos:Concept;
        skos:altLabel    "purine nucleoside bisphosphate";
        skos:broader     CHEMONTID:0002134;
