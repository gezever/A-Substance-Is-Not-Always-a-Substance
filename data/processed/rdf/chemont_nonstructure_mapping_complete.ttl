        skos:broader     CHEMONTID:0003354;
        skos:definition  "Organic compounds containing a thieno[3,4-d]pyridazine that carries an amino group at the 2-position. Thieno[3,4-d]pyridazine is a bicyclic compound made up of a thiophene ring fused to a pyridazine ring so that the sulfur atom and the two nitrogen atoms are at the 1-, 4-, and 5-position, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003356";
