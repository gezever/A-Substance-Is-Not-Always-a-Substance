        skos:prefLabel   "Phenylacetaldehydes"@en .

CHEMONTID:0004681  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0001443;
        skos:definition  "Polycyclic aromatic compounds containing a 1,2,4-triazolo[1,5-a]pyrimidine ring system, which is substituted with a sulfonamide at the 2-position.";
