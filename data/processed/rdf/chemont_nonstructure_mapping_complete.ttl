        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004187";
        skos:prefLabel   "Phorbines"@en .

CHEMONTID:0002117  rdf:type  skos:Concept;
        skos:altLabel    "a triazolopyridazine" , "triazolopyridazine";
        skos:broader     CHEMONTID:0000002;
