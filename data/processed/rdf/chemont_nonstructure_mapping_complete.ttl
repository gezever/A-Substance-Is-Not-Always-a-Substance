CHEMONTID:0003418  rdf:type  skos:Concept;
        skos:altLabel    "lignan";
        skos:broader     CHEMONTID:0001392;
        skos:definition  "Neolignans in which the two C6-C3 units are linked together by a bond other than Cbeta-Cbeta'. They usually consist of a 1-benzofuran or 2,3-dihydro-1-benzofuran, which is substituted a the 2-, 3-, and 5-positions with a phenyl group, a methyl group, and a propyl group, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
