        skos:narrower    CHEMONTID:0000200;
        skos:notation    "CHEMONTID:0002817";
        skos:prefLabel   "Dibenzopyrans"@en .

CHEMONTID:0000027  rdf:type  skos:Concept;
        skos:altLabel    "indanes";
        skos:broader     CHEMONTID:0002448;
