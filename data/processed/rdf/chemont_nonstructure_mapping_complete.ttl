        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002884";
        skos:prefLabel   "Lupane triterpenoids"@en .

CHEMONTID:0001403  rdf:type  skos:Concept;
        skos:altLabel    "ergostanoid";
        skos:broader     CHEMONTID:0003567;
