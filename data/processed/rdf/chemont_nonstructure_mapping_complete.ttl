CHEMONTID:0002283  rdf:type  skos:Concept;
        skos:altLabel    "pterins";
        skos:broader     CHEMONTID:0000110;
        skos:definition  "Heterocyclic aromatic compounds containing a pterin moiety, in which one ring is substituted by one or more carboxylic acid groups. Pterin is a heterocyclic compound composed of a pteridine ring system (made up of a pyrazine fused to a pyrimidine), with a keto group and an amino group at the 2- and 4- positions, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002283";
        skos:prefLabel   "Pterin carboxylates"@en .

CHEMONTID:0002958  rdf:type  skos:Concept;
        skos:altLabel    "isoquinolines";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Isoquinoline derivatives where exactly two carbon atoms joined by an aromatic bond are linked with a hydrogen atom each, resulting in a CC single bond.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002958";
        skos:prefLabel   "Dihydroisoquinolines"@en .

CHEMONTID:0004518  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0004517;
        skos:definition  "P-toluenesulfonamide derivatives in which the sulfonamide moiety is N,N-disubstituted.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004518";
        skos:prefLabel   "N,N-disubstituted p-toluenesulfonamides"@en .

CHEMONTID:0000391  rdf:type  skos:Concept;
        skos:altLabel    "Mitomycins" , "mitomycin";
        skos:broader     CHEMONTID:0004096;
