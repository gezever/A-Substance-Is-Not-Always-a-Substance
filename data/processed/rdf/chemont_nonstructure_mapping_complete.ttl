        skos:broader     CHEMONTID:0000293;
        skos:definition  "Compounds with two benzene rings connected by an azepine ring. Azepine is an unsaturated seven-member heterocycle with one nitrogen atom replacing a carbon atom.";
        skos:inScheme    conceptscheme:chemical_substance;
