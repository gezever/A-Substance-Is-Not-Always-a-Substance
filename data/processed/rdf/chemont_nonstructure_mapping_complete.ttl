CHEMONTID:0003354  rdf:type  skos:Concept;
        skos:altLabel    "organosulfur heterocyclic compound" , "organonitrogen heterocyclic compound";
        skos:broader     CHEMONTID:0003352;
        skos:definition  "Organic heterocyclic compounds consisting of a thieno[3,4-d]pyridazine moiety. Thieno[3,4-d]pyridazine is a bicyclic compound made up of a thiophene ring fused to a pyridazine ring so that the sulfur atom and the two nitrogen atoms are at the 1-, 4-, and 5-position, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003356;
        skos:notation    "CHEMONTID:0003354";
        skos:prefLabel   "Thieno[3,4-d]pyridazines"@en .

CHEMONTID:0001896  rdf:type  skos:Concept;
        skos:altLabel    "organosulfur heterocyclic compound" , "organic heterotricyclic compound" , "organonitrogen heterocyclic compound";
        skos:broader     CHEMONTID:0000056;
        skos:definition  "Heterocyclic compounds containing a thiophene ring fused to a quinoline. Quinoline or benzo[b]pyridine is a bicyclic compound that consists of benzene fused to a pyridine.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001896";
        skos:prefLabel   "Thienoquinolines"@en .

CHEMONTID:0000056  rdf:type  skos:Concept;
        skos:altLabel    "Quinolones" , "quinolone";
        skos:broader     CHEMONTID:0001253;
        skos:definition  "Compounds containing a quinoline moiety which bears a ketone group.";
        skos:inScheme    conceptscheme:chemical_substance;
