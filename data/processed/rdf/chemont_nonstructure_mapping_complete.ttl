CHEMONTID:0000777  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000447;
        skos:definition  "Inorganic compounds in which the largest oxoanion is selenate, and in which the heaviest atom not in an oxoanion is a lanthanide.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000777";
        skos:prefLabel   "Lanthanide selenates"@en .

CHEMONTID:0000130  rdf:type  skos:Concept;
