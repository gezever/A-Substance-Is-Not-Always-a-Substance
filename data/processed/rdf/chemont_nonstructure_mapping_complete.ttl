        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004444";
        skos:prefLabel   "Organochlorosilanes"@en .

CHEMONTID:0001629  rdf:type  skos:Concept;
        skos:altLabel    "indazoles";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Organic compounds containing a benzene ring fused to a pyrazole ring. Pyrazole is a 5-membered ring consisting of three carbon atoms and two adjacent nitrogen centers.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0000080;
        skos:notation    "CHEMONTID:0001629";
        skos:prefLabel   "Benzopyrazoles"@en .

CHEMONTID:0000668  rdf:type  skos:Concept;
        skos:altLabel    "thiosulfate" , "alkali metal salt";
        skos:broader     CHEMONTID:0000445;
        skos:definition  "Inorganic compounds in which the largest oxoanion is thiosulfate, and in which the heaviest atom not in an oxoanion is an alkali metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000668";
        skos:prefLabel   "Alkali metal thiosulfates"@en .

CHEMONTID:0002493  rdf:type  skos:Concept;
        skos:altLabel    "Benzoquinones" , "m-quinone" , "benzoquinones";
        skos:broader     CHEMONTID:0002384;
        skos:definition  "Benzoquinones where the two C=O groups are attached at the 1- and 3-position, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002493";
        skos:prefLabel   "M-benzoquinones"@en .

CHEMONTID:0003559  rdf:type  skos:Concept;
        skos:altLabel    "diterpenoid";
        skos:broader     CHEMONTID:0001551;
        skos:definition  "Diterpenoids with a structure based on the elisabethane skeleton, a tricyclic serrulatane derivative that is formed by connecting the C1 and C9 atom of serrulatane. This class of compounds also includes seco-elisabethane derivatives, nor-elisabethanes (resulting from the loss of one carbon atom), and bisnor-elisabethanes (resulting from the loss of two carbon atoms).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003559";
        skos:prefLabel   "Elisabethane diterpenoids"@en .

CHEMONTID:0000840  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000450;
        skos:definition  "Inorganic compounds in which the largest oxoanion is hyponitrite, and in which the heaviest atom not in an oxoanion is a transition metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000840";
        skos:prefLabel   "Transition metal hyponitrites"@en .

CHEMONTID:0000631  rdf:type  skos:Concept;
        skos:altLabel    "bromate salt" , "alkali metal salt";
        skos:broader     CHEMONTID:0000445;
        skos:definition  "Inorganic compounds in which the largest oxoanion is bromate, and in which the heaviest atom not in an oxoanion is an alkali metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000631";
        skos:prefLabel   "Alkali metal bromates"@en .

CHEMONTID:0003472  rdf:type  skos:Concept;
