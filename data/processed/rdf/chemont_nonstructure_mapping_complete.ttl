        skos:broader     CHEMONTID:0000279;
        skos:definition  "Organic compounds that contain a tropolone ring fused to an isoquinoline ring to form an azuleno[1,2,3-ij]isoquinoline skeleton.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003016";
        skos:prefLabel   "Tropoloisoquinolines"@en .

CHEMONTID:0003722  rdf:type  skos:Concept;
        skos:altLabel    "nucleoside analogue" , "pyrimidines";
        skos:broader     CHEMONTID:0003741;
        skos:definition  "Nucleoside analogues with a structure that consists of a cyclopropane that is substituted a the 1-position with a hydroxyl group and at the 2- position with either a pyrimidine base.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003722";
        skos:prefLabel   "Cyclopropyl pyrimidine nucleosides"@en .

CHEMONTID:0003741  rdf:type  skos:Concept;
        skos:altLabel    "nucleobase-containing molecular entity";
        skos:broader     CHEMONTID:0003737;
        skos:definition  "Nucleoside analogues with a structure that consists of a cyclopropane that is substituted a the 1-position with a hydroxyl group and at the 2- position with either a purine or pyrimidine base.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003722 , CHEMONTID:0003721;
        skos:notation    "CHEMONTID:0003741";
        skos:prefLabel   "Cyclopropyl nucleosides"@en .

CHEMONTID:0003493  rdf:type  skos:Concept;
        skos:altLabel    "sesquiterpenoid";
        skos:broader     CHEMONTID:0003543;
        skos:definition  "Fungal compounds or derivative thereof that contain a pyridine attached to the external pyran ring of a decahydro-2H,11H-benzo[f]pyrano[4,3-b]chromene ring system.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003493";
        skos:prefLabel   "Pyripyropenes"@en .

CHEMONTID:0002336  rdf:type  skos:Concept;
        skos:altLabel    "a phenylpyrrolidine" , "pyrrolidines";
        skos:broader     CHEMONTID:0000218;
        skos:definition  "Polycyclic aromatic compounds containing a benzene ring linked to a pyrrolidine ring through a CC or CN bond. Pyrrolidine is a five-membered saturated aliphatic heterocycle with one nitrogen atom and four carbon atoms.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002336";
        skos:prefLabel   "Phenylpyrrolidines"@en .

CHEMONTID:0001487  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0001470;
        skos:definition  "Inorganic compounds in which the largest metallic oxoanion is tetrahydroxyborate, to which either no atom or a non metal atom is bonded.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001487";
        skos:prefLabel   "Miscellaneous tetrahydroxyborates"@en .

CHEMONTID:0003140  rdf:type  skos:Concept;
        skos:altLabel    "organosilicon compound";
        skos:broader     CHEMONTID:0003265;
        skos:definition  "Organosilicon compounds with the general formula RO[Si](R')(OR'')OR''' (R-R''' = aliphatic organyl group).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003140";
        skos:prefLabel   "Trialkoxysilanes"@en .

CHEMONTID:0003265  rdf:type  skos:Concept;
        skos:altLabel    "silyl ether";
        skos:broader     CHEMONTID:0003194;
        skos:definition  "Organosilicon compounds with the general formula RO[Si](OR')(R'')(R''') (R,R' = organyl; R'',R''' = any atom).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003140;
        skos:notation    "CHEMONTID:0003265";
        skos:prefLabel   "Alkoxysilanes"@en .

CHEMONTID:0001816  rdf:type  skos:Concept;
        skos:altLabel    "furofuran";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Organic compounds containing a two furan rings fused to each other. Furan is a five-membered aromatic ring with four carbon atoms and one oxygen atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0001987;
        skos:notation    "CHEMONTID:0001816";
        skos:prefLabel   "Furofurans"@en .

CHEMONTID:0003733  rdf:type  skos:Concept;
        skos:altLabel    "nucleobase-containing molecular entity";
        skos:broader     CHEMONTID:0003737;
        skos:definition  "Nucleoside and nucleotide analogues with a structure that consists of a purine base, which N-substituted at the 1-position with a 3'-aza derivative  (1,3-oxazolidine) of the ribose moiety that is characteristic of nucleosides. Moreover, a phosphonate group s attached to the  C4-atom of the resulting 1.3-oxazolidine.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003733";
        skos:prefLabel   "Phosphonated 2'-oxa,3'-aza purine nucleosides"@en .

CHEMONTID:0004529  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0004196;
        skos:definition  "Aromatic heterocyclic compounds that contain an indole moiety substituted at the 3-position with a methyl group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004529";
        skos:prefLabel   "3-methylindoles"@en .

CHEMONTID:0004196  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0002497;
        skos:definition  "Compounds containing an indole moiety that carries an alkyl chain at the 3-position.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004529 , CHEMONTID:0004810;
        skos:notation    "CHEMONTID:0004196";
        skos:prefLabel   "3-alkylindoles"@en .

CHEMONTID:0001240  rdf:type  skos:Concept;
        skos:altLabel    "carboxylic anhydride";
        skos:broader     CHEMONTID:0001093;
        skos:definition  "Carboxylic acid derivatives two carbonyl groups where the carbon atoms are both linked to the same oxygen atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0000468;
        skos:notation    "CHEMONTID:0001240";
        skos:prefLabel   "Carboxylic acid anhydrides"@en .

CHEMONTID:0000807  rdf:type  skos:Concept;
        skos:altLabel    "Inorganic Chemicals" , "inorganic salt" , "Metalloids";
        skos:broader     CHEMONTID:0000449;
        skos:definition  "Inorganic compounds in which the largest oxoanion is perchlorate, and in which the heaviest atom not in an oxoanion is a metalloid.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000807";
        skos:prefLabel   "Metalloid perchlorates"@en .

CHEMONTID:0003401  rdf:type  skos:Concept;
        skos:altLabel    "Villanovane, atisane, trachylobane and helvifulvane diterpenoids" , "diterpenoid";
        skos:broader     CHEMONTID:0001551;
        skos:definition  "Diterpenoids with a structure based on the villanovane, atisane, trachylobane or helvifulvane skeleton. The astisane and atisane skeletons arise from the rearrangement of the beyerane cation intermediate. The trachylobane and helvifulvane skeletons are formed by rearrangement of the beyerane cation intermediate followed by cyclisation.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0002738 , CHEMONTID:0003400;
        skos:notation    "CHEMONTID:0003401";
