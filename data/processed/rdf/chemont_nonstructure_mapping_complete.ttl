        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003746";
        skos:prefLabel   "3'-thia pyrimidine nucleosides"@en .

CHEMONTID:0001424  rdf:type  skos:Concept;
        skos:altLabel    "phosphosphingolipid" , "Lysosphingomyelins and lysoglycosphingolipids";
