        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003075;
        skos:notation    "CHEMONTID:0003074";
        skos:prefLabel   "Arylsufonic acids"@en .

CHEMONTID:0003324  rdf:type  skos:Concept;
        skos:altLabel    "wax ester";
        skos:broader     CHEMONTID:0003325;
        skos:definition  "Waxes based on alkane-1,2-diols (usually C12-C23) esterified with C10-C20 acids at the two hydroxyl groups.";
        skos:inScheme    conceptscheme:chemical_substance;
