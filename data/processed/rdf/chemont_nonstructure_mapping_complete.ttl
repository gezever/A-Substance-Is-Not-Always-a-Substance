CHEMONTID:0003283  rdf:type  skos:Concept;
        skos:altLabel    "hydroxamic acid";
        skos:broader     CHEMONTID:0000376;
        skos:definition  "Organic aromatic compounds containing a benzene ring N-linked to a N-hydroxylamide group. They have the generic structure [H]ON(R)C(R')=O, where R= aryl group, R'= organyl group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003283";
