        skos:notation    "CHEMONTID:0002903";
        skos:prefLabel   "Perylenequinones"@en .

CHEMONTID:0004274  rdf:type  skos:Concept;
        skos:altLabel    "1(3)-O-alkylglycerol" , "1-O-alkyl-sn-glycerol";
