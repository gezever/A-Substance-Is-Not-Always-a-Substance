        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001337";
        skos:prefLabel   "1,3-diazepines"@en .

CHEMONTID:0002912  rdf:type  skos:Concept;
        skos:altLabel    "ketone";
        skos:broader     CHEMONTID:0000118;
