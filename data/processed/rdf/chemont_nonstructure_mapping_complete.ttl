CHEMONTID:0000676  rdf:type  skos:Concept;
        skos:altLabel    "taxane diterpenoid" , "Taxane and Abeotaxane diterpenoids";
        skos:broader     CHEMONTID:0001551;
        skos:definition  "Diterpenoids with a structure based either on the taxane skeleton, or a derivative thereof. In term of phytochemistry, several derivatives of the taxane skeleton exist: 2(3->20)-abeotaxane, 3,11-cyclotaxane, 11(15->1),11(10->9)-abeotaxane, 3,8-seco-taxane, and 11(15->1)-abeotaxane, among others. More complex skeletons have been found recently, which include the taxane-derived [3.3.3] propellane ring system.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000676";
        skos:prefLabel   "Taxanes and derivatives"@en .

