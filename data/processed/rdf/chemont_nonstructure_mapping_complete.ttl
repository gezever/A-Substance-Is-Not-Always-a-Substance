CHEMONTID:0001844  rdf:type  skos:Concept;
        skos:altLabel    "flavonolignan";
        skos:broader     CHEMONTID:0001392;
        skos:definition  "Non-conventional lignans that derived from flavonoids. They are characterized by a p-dioxin ring substituted at one carbon atom by a C3C6 (phenylpropan) group and fused to the B-ring of the 2-phenylchromene moiety.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001844";
        skos:prefLabel   "Flavonolignans"@en .

CHEMONTID:0001392  rdf:type  skos:Concept;
        skos:altLabel    "phenylpropanoid";
        skos:broader     CHEMONTID:0000000;
        skos:definition  "Plant products of low molecular weight formed primarily from oxidative coupling of two p-propylphenol moieties. They can also be described as micromolecules with two phenylpropanoid units coupled together. They can be attached in various manners, like C5-C5', C8-C8'. Most known natural lignans are oxidized at C9 and C9´ and, based upon the way in which oxygen is incorporated into the skeleton and on the cyclization patterns, a wide range of lignans of very different structural types can be formed.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0001510 , CHEMONTID:0001623 , CHEMONTID:0001511 , CHEMONTID:0003495 , CHEMONTID:0001844 , CHEMONTID:0003418 , CHEMONTID:0001610 , CHEMONTID:0002545 , CHEMONTID:0003419 , CHEMONTID:0001969 , CHEMONTID:0003425 , CHEMONTID:0003686;
        skos:notation    "CHEMONTID:0001392";
        skos:prefLabel   "Lignans, neolignans and related compounds"@en .

