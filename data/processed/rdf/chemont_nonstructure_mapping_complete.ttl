        skos:broader     CHEMONTID:0001272;
        skos:definition  "Aromatic compounds containing a meta-cresol moiety, which consists of a benzene ring bearing a methyl group and a hydroxyl group at ring positions 1 and 3, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001273";
        skos:prefLabel   "Meta cresols"@en .

