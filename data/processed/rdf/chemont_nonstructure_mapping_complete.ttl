        skos:broader     CHEMONTID:0000449;
        skos:definition  "Inorganic compounds in which the largest oxoanion is sulfite, and in which the heaviest atom not in an oxoanion is a post-transition metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000820";
        skos:prefLabel   "Metalloid sulfites"@en .

