        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002883";
        skos:prefLabel   "Scalarane sesterterpenoids"@en .

CHEMONTID:0000828  rdf:type  skos:Concept;
