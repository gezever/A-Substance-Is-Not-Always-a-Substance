        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002117";
        skos:prefLabel   "Triazolopyridazines"@en .

CHEMONTID:0004068  rdf:type  skos:Concept;
        skos:altLabel    "organic salt" , "organotin compound";
        skos:broader     CHEMONTID:0004038;
        skos:definition  "Organic compounds containing a tin atom bonded to three carbon atoms and a metal atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004068";
        skos:prefLabel   "Triorganotin metal salts"@en .

CHEMONTID:0000947  rdf:type  skos:Concept;
        skos:altLabel    "p-block molecular entity";
        skos:broader     CHEMONTID:0000451;
        skos:definition  "Inorganic compounds in which the largest oxoanion is tungstate, and in which the heaviest atom not in an oxoanion is a post-transition metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000947";
        skos:prefLabel   "Post-transition metal tungstates"@en .

