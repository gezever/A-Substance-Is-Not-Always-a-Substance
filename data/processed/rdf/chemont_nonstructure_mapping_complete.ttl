        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003674";
        skos:prefLabel   "Alpha-branched alpha,beta-unsaturated ketones"@en .

CHEMONTID:0002774  rdf:type  skos:Concept;
