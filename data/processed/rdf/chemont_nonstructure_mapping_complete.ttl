        skos:prefLabel   "N-acyl-alpha amino acids and derivatives"@en .

CHEMONTID:0003746  rdf:type  skos:Concept;
        skos:altLabel    "nucleobase-containing molecular entity";
        skos:broader     CHEMONTID:0003737;
