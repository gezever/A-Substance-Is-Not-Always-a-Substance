CHEMONTID:0000385  rdf:type  skos:Concept;
        skos:altLabel    "steroid alkaloid";
        skos:broader     CHEMONTID:0002724;
        skos:definition  "Potent cardiotoxic and neurotoxic alkaloids containing a C21-steroid backbone. They have been characterized  from skin extracts of different frog species. The batrachotoxins have a homomorpholine ring at the steroidal CD-ring junction, a 3,9-hemiketal bridge and, in some cases, a 20beta-2,4-dialkylpyrrole-3-carboxylate moiety.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000385";
        skos:prefLabel   "Batrachotoxins and derivatives"@en .

