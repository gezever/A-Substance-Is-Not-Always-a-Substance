        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004559";
        skos:prefLabel   "Avenanthramides"@en .

CHEMONTID:0001901  rdf:type  skos:Concept;
        skos:altLabel    "peptide";
        skos:broader     CHEMONTID:0001813;
        skos:definition  "Peptide analogues containing two 2-sulfonylethan-1-amine groups linked together through a bond between the terminal nitrogen atom of one group and the sulfur atom (of the sulfonyl ) from the other group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001901";
        skos:prefLabel   "Beta-sulfonopeptides"@en .

CHEMONTID:0002814  rdf:type  skos:Concept;
        skos:altLabel    "N-glycosyl compound";
        skos:broader     CHEMONTID:0000374;
