CHEMONTID:0003669  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0003667;
        skos:definition  "1,3-dipolar compounds with the general structure  X#N+-Z- <-> X-=N+=Z <-> X-=N-Z+ <-> X-N=Z (X =O, Z =N, or O).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003669";
