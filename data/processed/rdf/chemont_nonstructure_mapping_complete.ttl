        skos:prefLabel   "Hippuric acids"@en .

CHEMONTID:0000556  rdf:type  skos:Concept;
        skos:altLabel    "astatine molecular entity" , "actinoid molecular entity";
        skos:broader     CHEMONTID:0000441;
        skos:definition  "Inorganic compounds in which the largest halogen atom is Astatine, and the heaviest metal atom is an actinide.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000556";
        skos:prefLabel   "Actinide astatides"@en .

CHEMONTID:0003142  rdf:type  skos:Concept;
        skos:altLabel    "organosulfur compound" , "organonitrogen compound";
        skos:broader     CHEMONTID:0000004;
        skos:definition  "Organosulfur compounds with the general formula N=S(R)(=S)N(R')R\" (R=organyl; R',R\" = any atom but N).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003142";
        skos:prefLabel   "S-aminosulfonimidothioyl compounds"@en .

CHEMONTID:0000972  rdf:type  skos:Concept;
        skos:altLabel    "Inorganic Chemicals" , "p-block molecular entity" , "Metalloids";
        skos:broader     CHEMONTID:0000449;
        skos:definition  "Inorganic compounds in which the largest oxoanion is arsenate, and in which the heaviest atom not in an oxoanion is a post-transition metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000972";
        skos:prefLabel   "Metalloid arsenates"@en .

CHEMONTID:0002024  rdf:type  skos:Concept;
        skos:altLabel    "N-acylurea" , "a N,N'-diacyl urea";
        skos:broader     CHEMONTID:0002022;
