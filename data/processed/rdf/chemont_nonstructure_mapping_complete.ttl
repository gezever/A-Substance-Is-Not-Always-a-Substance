CHEMONTID:0000530  rdf:type  skos:Concept;
        skos:altLabel    "p-block molecular entity" , "inorganic oxide";
        skos:broader     CHEMONTID:0000458;
        skos:definition  "Inorganic compounds containing an oxygen atom of an oxidation state of -2, in which the heaviest atom bonded to the oxygen is a post-transition metal.";
        skos:inScheme    conceptscheme:chemical_substance;
