        skos:prefLabel   "Sphingolipids"@en .

CHEMONTID:0003870  rdf:type  skos:Concept;
        skos:altLabel    "organic molecular entity";
        skos:broader     CHEMONTID:0003662;
        skos:definition  "Organophosphorus compounds containing a monoamide derivative of a phosphoric acid diester functional group. They have the general structure R1OP(=O)(N(R2)R3)N(R4)R5, where R1 = organyl group and R2-R5 = H or organyl.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003870";
        skos:prefLabel   "Phosphoric monoester diamides"@en .

CHEMONTID:0003042  rdf:type  skos:Concept;
        skos:altLabel    "pteridines";
        skos:broader     CHEMONTID:0000110;
        skos:definition  "Heterocyclic compounds based on the 5,6,7,8-tetrahydropteroic acid skeleton (or derivative thereof).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003045 , CHEMONTID:0002618;
        skos:notation    "CHEMONTID:0003042";
        skos:prefLabel   "Tetrahydropteroic acids and derivatives"@en .

CHEMONTID:0001838  rdf:type  skos:Concept;
