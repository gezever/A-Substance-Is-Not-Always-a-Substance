        skos:notation    "CHEMONTID:0003744";
        skos:prefLabel   "Phosphonated cyclopropyl nucleosides"@en .

CHEMONTID:0001386  rdf:type  skos:Concept;
        skos:altLabel    "oxacycle";
        skos:broader     CHEMONTID:0001384;
