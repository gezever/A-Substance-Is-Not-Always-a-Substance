CHEMONTID:0003550  rdf:type  skos:Concept;
        skos:altLabel    "Pachydictyane and cneorubin diterpenoids" , "diterpenoid";
        skos:broader     CHEMONTID:0001551;
        skos:definition  "Diterpenoids with a structure that is based either on the pachydictyane or the cneorubin skeleton. Pachydictyane is a bicyclic compound consisting of a guaiane skeleton that carries a prenyl group attached to the C12 carbon atom. Cneorubin is a tricyclic compound consisting of a cycloprop[e]azulene where the cyclopropane carries a methyl group and a 4-methylpentyl group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003550";
        skos:prefLabel   "Pachydictyane and cneorubin diterpenoids"@en .

CHEMONTID:0000043  rdf:type  skos:Concept;
