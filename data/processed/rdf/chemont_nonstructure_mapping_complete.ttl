        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003634";
        skos:prefLabel   "Acyl carbenes"@en .

CHEMONTID:0003632  rdf:type  skos:Concept;
        skos:altLabel    "dipolar compound";
        skos:broader     CHEMONTID:0003630;
        skos:definition  "1,3-dipolar compounds with the general structure X:-C=Z<-> X+=C-Z- (X = C or N; Z = C, N, or O).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003634 , CHEMONTID:0003635 , CHEMONTID:0003636;
        skos:notation    "CHEMONTID:0003632";
        skos:prefLabel   "Carbene-type 1,3-dipolar compounds"@en .

CHEMONTID:0003521  rdf:type  skos:Concept;
        skos:altLabel    "pyranoxanthones";
        skos:broader     CHEMONTID:0000204;
