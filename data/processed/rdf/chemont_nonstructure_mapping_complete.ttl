CHEMONTID:0002518  rdf:type  skos:Concept;
        skos:altLabel    "Annonaceae acetogenins";
        skos:broader     CHEMONTID:0001334;
        skos:definition  "Waxy derivatives of fatty acids (usually C32 or C34), containing a terminal carboxylic acid combined with a 2-propanol unit at the C-2 position to form a methyl- substituted alpha,beta-unsaturated-gamma-lactone. One of their interesting structural features is a single, adjacent, or nonadjacent tetrahydrofuran (THF) or tetrahydropyran (THP) system with one or two flanking hydroxyl group(s) at the center of a long hydrocarbon chain.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002518";
        skos:prefLabel   "Annonaceous acetogenins"@en .

CHEMONTID:0004391  rdf:type  skos:Concept;
