        skos:notation    "CHEMONTID:0003797";
        skos:prefLabel   "(3'->5')-dinucleotide phosphorothioates"@en .

CHEMONTID:0002244  rdf:type  skos:Concept;
        skos:altLabel    "cyclic pyrimidine nucleotide";
        skos:broader     CHEMONTID:0001492;
