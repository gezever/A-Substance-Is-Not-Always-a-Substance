        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001711";
        skos:prefLabel   "Phlorotannins"@en .

CHEMONTID:0000238  rdf:type  skos:Concept;
        skos:altLabel    "tannin";
