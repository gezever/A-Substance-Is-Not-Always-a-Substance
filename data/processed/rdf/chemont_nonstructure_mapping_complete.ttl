CHEMONTID:0002318  rdf:type  skos:Concept;
        skos:altLabel    "carbacephem";
        skos:broader     CHEMONTID:0000162;
        skos:definition  "A new class of beta-lactam antibiotics similar in structure to the cephalosporins. They differ from cephalosporins, however, in the substitution of a sulfur atom in the dihydrothiazine ring with a methylene group to form a tetrahydropyridine ring.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002318";
        skos:prefLabel   "Carbacephems"@en .

CHEMONTID:0003676  rdf:type  skos:Concept;
        skos:altLabel    "carbonyl compound" , "epoxide";
        skos:broader     CHEMONTID:0000159;
        skos:definition  "Epoxide containing derivatives of enol esters. They have an acyloxy substituent on either carbon atom of the epoxide ring and their general structure is CC1OC1OC(R)=O, R = H or organyl chain.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003676";
        skos:prefLabel   "Enol ester epoxides"@en .

CHEMONTID:0001389  rdf:type  skos:Concept;
        skos:altLabel    "neoflavonoid";
        skos:broader     CHEMONTID:0001614;
        skos:definition  "Neoflavonoids with a structure based on the 4-phenylcoumarin skeleton.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001389";
        skos:prefLabel   "Neoflavones"@en .

CHEMONTID:0004136  rdf:type  skos:Concept;
        skos:altLabel    "Thiohydroximic acid";
        skos:broader     CHEMONTID:0000264;
        skos:definition  "Organosulfur compounds containing the thiohydroximic acid group (RC(S)=NOH, where R = H or organyl group) or a derivative thereof.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004137;
        skos:notation    "CHEMONTID:0004136";
        skos:prefLabel   "Thiohydroximic acids and derivatives"@en .

CHEMONTID:0004321  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000060;
        skos:definition  "Compounds containing phenylalanine or a derivative thereof resulting from reaction of phenylalanine at the amino group or the carboxy group, or from the replacement of any hydrogen of glycine by a heteroatom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004321";
        skos:prefLabel   "Phenylalanine and derivatives"@en .

CHEMONTID:0002075  rdf:type  skos:Concept;
        skos:altLabel    "quinomethanes";
        skos:broader     CHEMONTID:0000125;
        skos:definition  "Organic compounds containing a benzene ring conjugated to a methylidene group and a ketone at carbon atoms 1 and 3, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002075";
