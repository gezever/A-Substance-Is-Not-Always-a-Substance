        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004267";
        skos:prefLabel   "N-acyl-L-glutamines"@en .

CHEMONTID:0003674  rdf:type  skos:Concept;
        skos:altLabel    "enone";
        skos:broader     CHEMONTID:0003672;
