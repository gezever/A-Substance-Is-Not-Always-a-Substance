CHEMONTID:0000708  rdf:type  skos:Concept;
        skos:altLabel    "alkaline earth salt";
        skos:broader     CHEMONTID:0000446;
        skos:definition  "Inorganic compounds in which the largest oxoanion is dithionite, and in which the heaviest atom not in an oxoanion is a lanthanide.";
        skos:inScheme    conceptscheme:chemical_substance;
