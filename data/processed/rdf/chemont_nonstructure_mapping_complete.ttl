        skos:broader     CHEMONTID:0003624;
        skos:definition  "Organic heterocyclic compounds containing a 1,2-dithiole ring that bears a C=S group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002905";
        skos:prefLabel   "1,2-dithiole-3-thiones"@en .

CHEMONTID:0001099  rdf:type  skos:Concept;
        skos:altLabel    "organochlorine compound";
        skos:broader     CHEMONTID:0000035;
        skos:definition  "Compounds containing one or more chlorine atoms attached to a benzene moiety.";
