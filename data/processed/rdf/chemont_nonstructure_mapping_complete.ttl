        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003655";
        skos:prefLabel   "Eremophilane, 8,9-secoeremophilane and furoeremophilane sesquiterpenoids"@en .

CHEMONTID:0001506  rdf:type  skos:Concept;
        skos:altLabel    "purine nucleotide";
        skos:broader     CHEMONTID:0000289;
