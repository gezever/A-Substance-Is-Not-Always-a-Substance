CHEMONTID:0003561  rdf:type  skos:Concept;
        skos:altLabel    "diterpenoid";
        skos:broader     CHEMONTID:0001551;
        skos:definition  "Diterpenoids with a structure based on either the ileabethane, the pseudopterane, or the nor-sandresane skeleton. Ileabethane is a tricyclic carbon skeleton arising from the C8-C14 of serrulatane. In the nor-sandresane skeleton, a cyclohexane ring is fused to a seven-membered saturated aliphatic carbocycle, which could stem from the rearrangement of an amphilectane-based precursor involving loss of a carbon atom and a 1,2-alkyl shift with ring expansion.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003561";
        skos:prefLabel   "Ileabethane, pseudopterane or nor-sandresane diterpenoids"@en .

CHEMONTID:0001064  rdf:type  skos:Concept;
        skos:altLabel    "p-block molecular entity";
        skos:broader     CHEMONTID:0000435;
        skos:definition  "Inorganic non-metallic compounds containing a perbromate as its largest oxoanion.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001064";
        skos:prefLabel   "Non-metal perbromates"@en .

CHEMONTID:0003612  rdf:type  skos:Concept;
        skos:altLabel    "inorganic cation";
        skos:broader     CHEMONTID:0001568;
