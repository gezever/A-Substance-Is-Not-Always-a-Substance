        skos:broader     CHEMONTID:0000270;
        skos:definition  "Esters of sulfonic acid, which have the general structure RS(=O)2OR' (R,R' = organyl, not H).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001178";
        skos:prefLabel   "Organosulfonic acid esters"@en .

CHEMONTID:0002189  rdf:type  skos:Concept;
