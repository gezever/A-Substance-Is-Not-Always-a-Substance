        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002918";
        skos:prefLabel   "Serratane and onocerane triterpenoids"@en .

CHEMONTID:0000411  rdf:type  skos:Concept;
        skos:altLabel    "oxime" , "Oximes";
        skos:broader     CHEMONTID:0000278;
