        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000899";
        skos:prefLabel   "Alkali metal plumbates"@en .

CHEMONTID:0002102  rdf:type  skos:Concept;
        skos:altLabel    "organoarsenic compound" , "organonitrogen heterocyclic compound";
        skos:broader     CHEMONTID:0002052;
        skos:definition  "Organic compounds containing a six-member saturated aliphatic ring containing a nitrogen atom (at carbon 1), an arsenic atom (at carbon 4), and four carbon atoms.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002102";
        skos:prefLabel   "Azarsinanes"@en .

CHEMONTID:0002052  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Heterocyclic compounds contain one metal ring atom.";
