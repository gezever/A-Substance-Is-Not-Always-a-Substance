        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000391";
        skos:prefLabel   "Mitomycins"@en .

CHEMONTID:0004096  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000390;
        skos:definition  "A group of pyrroloindolediones, which carry a methyl group at the 6-position of their quinone moiety. The mitosane (containing an aziridine) and mitosene server as backbone for mitomycins and their derivatives.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0000391;
        skos:notation    "CHEMONTID:0004096";
        skos:prefLabel   "Mitomycins, mitosane and mitosene derivatives"@en .

CHEMONTID:0004609  rdf:type  skos:Concept;
