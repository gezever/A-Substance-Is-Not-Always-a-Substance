        skos:altLabel    "20-norgibberellane diterpenoids" , "C19-gibberellin" , "20-norgibberellins";
        skos:broader     CHEMONTID:0001767;
        skos:definition  "Gibberellins containing 19 carbon atoms, with the COOH group in position 7. In nearly all C19-gibberellins, the carboxyl group at C-4 forms a lactone  ring at C-10, a configuration which arises in connection with the loss of the extra C-20 atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004016 , CHEMONTID:0004013;
        skos:notation    "CHEMONTID:0002998";
        skos:prefLabel   "C19-gibberellins"@en .

