        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004391";
        skos:prefLabel   "4-Anilinoquinazolines"@en .

CHEMONTID:0004575  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0004570;
