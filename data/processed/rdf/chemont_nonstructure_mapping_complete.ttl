        skos:prefLabel   "Pyrimidine 2',3'-dideoxyribonucleoside triphosphates"@en .

CHEMONTID:0001868  rdf:type  skos:Concept;
        skos:altLabel    "imidazoles" , "nucleobase-containing molecular entity";
