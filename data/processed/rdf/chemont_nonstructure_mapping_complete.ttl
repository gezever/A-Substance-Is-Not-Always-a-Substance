        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004245";
        skos:prefLabel   "Triorganodihaloarsoranes"@en .

CHEMONTID:0003723  rdf:type  skos:Concept;
