        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000828";
        skos:prefLabel   "Metalloid dithionites"@en .

CHEMONTID:0004521  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0001026;
