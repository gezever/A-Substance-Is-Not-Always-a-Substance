        skos:definition  "Alkaloids with a structure based on the 4a-homomorphinan skeleton. 4a-homomorphinan is a tetracyclic compound similar to morphinan, with the difference that the benzene ring is replaced by a cycloheptatriene ring.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003772";
        skos:prefLabel   "4a-homomorphinans"@en .

CHEMONTID:0002346  rdf:type  skos:Concept;
        skos:altLabel    "methoxybenzoic acid";
        skos:broader     CHEMONTID:0002344;
        skos:definition  "Benzoic acids in which the hydrogen atom at position 4 of the benzene ring is replaced by a methoxy group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002346";
        skos:prefLabel   "P-methoxybenzoic acids and derivatives"@en .

CHEMONTID:0002706  rdf:type  skos:Concept;
