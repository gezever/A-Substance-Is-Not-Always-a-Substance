        skos:definition  "Organosulfur compounds containing an aliphatic group attached to a sulfinic acid group (or a derivative thereof), with the general formula RSO2R' (R= alkyl, R'=any atom).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003462;
        skos:notation    "CHEMONTID:0003461";
        skos:prefLabel   "Alkanesulfinic acids and derivatives"@en .

CHEMONTID:0002402  rdf:type  skos:Concept;
        skos:altLabel    "N-acyl-amino acid";
        skos:broader     CHEMONTID:0001189;
