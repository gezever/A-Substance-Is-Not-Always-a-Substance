        skos:prefLabel   "Trifluoromethylbenzenes"@en .

CHEMONTID:0004670  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0002341;
        skos:definition  "Aromatic compounds that contain a phenol ether, which carries an amine group on the benzene ring.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004670";
        skos:prefLabel   "Aminophenyl ethers"@en .

CHEMONTID:0000564  rdf:type  skos:Concept;
        skos:altLabel    "fluoride salt" , "alkali metal salt";
        skos:broader     CHEMONTID:0000438;
        skos:definition  "Inorganic compounds in which the largest halogen atom is fluorine, and the heaviest metal atom is an alkali metal.";
        skos:inScheme    conceptscheme:chemical_substance;
