        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001402";
        skos:prefLabel   "Imidazolinones"@en .

CHEMONTID:0000169  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000162;
        skos:definition  "Organic compounds containing a 4-oxa-1-azabicyclo[3.2.0]heptan-7-one moiety. Clavams are similar to penams, but with an oxygen substituted for the sulfur in the penam skeleton.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000169";
        skos:prefLabel   "Clavams"@en .

CHEMONTID:0003461  rdf:type  skos:Concept;
        skos:altLabel    "sulfinic acid derivative";
