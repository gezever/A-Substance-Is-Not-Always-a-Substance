        skos:notation    "CHEMONTID:0003950";
        skos:prefLabel   "Isporenylated bicyclo [2.2.2] alkaloids"@en .

CHEMONTID:0001814  rdf:type  skos:Concept;
        skos:altLabel    "phosphine";
        skos:broader     CHEMONTID:0002279;
