        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001140";
        skos:prefLabel   "Harmala alkaloids"@en .

CHEMONTID:0002872  rdf:type  skos:Concept;
        skos:altLabel    "sesquiterpenoid" , "Elemane sesquiterpenoids";
