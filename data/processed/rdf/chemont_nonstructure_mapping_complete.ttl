        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003521 , CHEMONTID:0003518 , CHEMONTID:0003517 , CHEMONTID:0003519;
        skos:notation    "CHEMONTID:0000204";
        skos:prefLabel   "Xanthones"@en .

CHEMONTID:0003945  rdf:type  skos:Concept;
        skos:altLabel    "inorganic hydride";
        skos:broader     CHEMONTID:0001568;
