        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001169";
        skos:prefLabel   "Phosphonic acid esters"@en .

CHEMONTID:0001318  rdf:type  skos:Concept;
        skos:altLabel    "N-acylglycine" , "N-benzoylglycines" , "N-benzoylglycinates";
        skos:broader     CHEMONTID:0000179;
