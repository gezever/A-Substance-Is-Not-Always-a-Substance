        skos:broader     CHEMONTID:0000023;
        skos:definition  "Organonitrogen aromatic compounds that contain a central azo group, where each nitrogen atom is conjugated to the 1-position of a naphthalene ring system. Naphthalene is a compound made up of two fused benzene rings.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003653";
        skos:prefLabel   "1,1'-azonaphthalenes"@en .

CHEMONTID:0002576  rdf:type  skos:Concept;
        skos:altLabel    "oxazinane";
        skos:broader     CHEMONTID:0000107;
        skos:definition  "Compounds containing an oxazinane ring with the nitrogen atom and the oxygen atom at positions 1  and 2, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002576";
        skos:prefLabel   "1,2-oxazinanes"@en .

CHEMONTID:0001072  rdf:type  skos:Concept;
        skos:altLabel    "p-block molecular entity";
        skos:broader     CHEMONTID:0000435;
        skos:definition  "Inorganic non-metallic compounds containing a phosphite as its largest oxoanion.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001072";
        skos:prefLabel   "Non-metal phosphites"@en .

CHEMONTID:0004689  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0004687;
        skos:definition  "Naphthalene-2-carboxamides, where the carboxamide group is substituted with an aniline, and the naphthalene ring system is hydroxylated at the ring 8-position.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004689";
        skos:prefLabel   "8-hydroxynaphthalene-2-carboxanilides"@en .

CHEMONTID:0002661  rdf:type  skos:Concept;
        skos:altLabel    "Tropolonoisoquinoline alkaloids" , "Type C colchicaceae alkaloids";
        skos:broader     CHEMONTID:0000279;
        skos:definition  "Alkaloids derived from phenethylisoquinoline precursors by direct intramolecular oxidative coupling. They incorporate a nucleus A and are always pentaoxygenated at C- 1, -2, - 10, - 11, and - 12. The nitrogen function in ring B is usually N-methylated, but it may also be secondary.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002661";
        skos:prefLabel   "Homoaporphines"@en .

CHEMONTID:0002944  rdf:type  skos:Concept;
        skos:altLabel    "oxacycle" , "organonitrogen heterocyclic compound";
        skos:broader     CHEMONTID:0002943;
        skos:definition  "Dioxepanes with the two ring oxygen atoms at position 1 and 2, respectively.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002944";
        skos:prefLabel   "1,2-dioxepanes"@en .

CHEMONTID:0001162  rdf:type  skos:Concept;
        skos:altLabel    "carbamate ester" , "Carbamic Acid Esters";
        skos:broader     CHEMONTID:0000318;
        skos:definition  "Compounds containing an ester of carbamic acid with the general structure R2NC(=O)OR' (R' not H). They are esters of carbamic acids.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004787;
        skos:notation    "CHEMONTID:0001162";
        skos:prefLabel   "Carbamate esters"@en .

CHEMONTID:0004559  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0002503;
