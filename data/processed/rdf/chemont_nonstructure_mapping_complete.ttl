        skos:definition  "Organonitrogen compounds containing an acrylic acid ester, which carries a nitrile group. They have the general structure ROC(=O)C(=C)C#N, where R is an organic group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004768";
        skos:prefLabel   "Cyanoacrylates"@en .

