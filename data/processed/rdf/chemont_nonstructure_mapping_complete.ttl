CHEMONTID:0001817  rdf:type  skos:Concept;
        skos:altLabel    "sterigmatocystins";
        skos:broader     CHEMONTID:0000261;
        skos:definition  "A group of closely related fungal metabolites chemically characterized by a xanthone moiety fused to a dihydrodifurano or a tetrahydrodifurano moiety. The chemical difference among the various sterigmagocystins are the presence or absence of unsaturation at positions 2 and 3 of the difurano ring system, the substitution pattern on positions 6, 7, and 10 of the xanthone system and/or the substituent on position 3 of the difurano system. They are produced by Aspergilus spp. and Bipolaris spp.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001817";
        skos:prefLabel   "Sterigmatocystins"@en .

CHEMONTID:0000261  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000000;
        skos:definition  "Organic compounds that are synthesized either from the amino acid phenylalanine (phenylpropanoids) or the decarboxylative condensation of malonyl-CoA (polyketides). Phenylpropanoids are aromatic compounds based on the phenylpropane skeleton. Polyketides usually consist of alternating carbonyl and methylene groups (beta-polyketones), biogenetically derived from repeated condensation of acetyl coenzyme A (via malonyl coenzyme A), and usually the compounds derived from them by further condensations.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0001808 , CHEMONTID:0000147 , CHEMONTID:0001802 , CHEMONTID:0002507 , CHEMONTID:0001614 , CHEMONTID:0001890 , CHEMONTID:0002612 , CHEMONTID:0002900 , CHEMONTID:0003415 , CHEMONTID:0001817 , CHEMONTID:0001787 , CHEMONTID:0000181 , CHEMONTID:0002551 , CHEMONTID:0003467 , CHEMONTID:0000334 , CHEMONTID:0000476 , CHEMONTID:0001761 , CHEMONTID:0002506 , CHEMONTID:0002650 , CHEMONTID:0002754 , CHEMONTID:0001645 , CHEMONTID:0000253 , CHEMONTID:0000145 , CHEMONTID:0000238 , CHEMONTID:0001649 , CHEMONTID:0001900 , CHEMONTID:0003405 , CHEMONTID:0000064 , CHEMONTID:0002106 , CHEMONTID:0001304 , CHEMONTID:0000029 , CHEMONTID:0001631 , CHEMONTID:0002642 , CHEMONTID:0001800;
        skos:notation    "CHEMONTID:0000261";
        skos:prefLabel   "Phenylpropanoids and polyketides"@en .

