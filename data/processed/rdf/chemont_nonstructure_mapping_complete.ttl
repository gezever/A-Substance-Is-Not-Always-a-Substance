        skos:definition  "Aromatic compounds containing an isoindole, which is N-substituted by an organothiophosphate group. Their general structure is R-CSP(=S)(OR')OR'', where R=isoindole, R',R\" = any atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004658";
