        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004275;
        skos:notation    "CHEMONTID:0004274";
        skos:prefLabel   "1-O-alkylglycerols"@en .

CHEMONTID:0003263  rdf:type  skos:Concept;
        skos:altLabel    "Monoalkylglycerols" , "alkylglycerol";
