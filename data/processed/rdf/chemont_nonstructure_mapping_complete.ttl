CHEMONTID:0002783  rdf:type  skos:Concept;
        skos:altLabel    "Akuammiline alkaloids";
        skos:broader     CHEMONTID:0000279;
        skos:definition  "Alkaloids with a structure based on either the akuammilan skeleton. The ring system in this group is formed from a precursor of the corynantheine type by bond formation between C-16 and C-7. Variations in this subgroup include, among others, alkaloids derived by C-3 to N-4 bond fission, as well as alkaloids in which the N-4 to C-5 bond in the Akuammiline skeleton has been severed.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002783";
        skos:prefLabel   "Akuammilan and related alkaloids"@en .

CHEMONTID:0002053  rdf:type  skos:Concept;
        skos:altLabel    "silyl enol ether" , "Organosilicon Compounds";
