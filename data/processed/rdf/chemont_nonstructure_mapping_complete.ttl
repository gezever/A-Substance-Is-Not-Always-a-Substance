        skos:prefLabel   "Pyridoxine-5'-phosphates"@en .

CHEMONTID:0001907  rdf:type  skos:Concept;
        skos:altLabel    "a phenanthroquinolizidine" , "organonitrogen heterocyclic compound" , "organic heteropentacyclic compound";
        skos:broader     CHEMONTID:0000025;
        skos:definition  "Aromatic polycyclic compounds containing the phenanthroindolizidine skeleton, which is structurally characterized by an indolizidine and a phenanthrene, where the quinolizidine is fused to the second benzene ring of a phenanthrene.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001907";
        skos:prefLabel   "Phenanthroquinolizidines"@en .

