        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004394 , CHEMONTID:0004395;
        skos:notation    "CHEMONTID:0001984";
        skos:prefLabel   "Phenylpiperazines"@en .

CHEMONTID:0003023  rdf:type  skos:Concept;
        skos:altLabel    "N-acylpyrrolidine";
        skos:broader     CHEMONTID:0000218;
        skos:definition  "N-Acylated Pyrrolidine derivatives. Pyrrolidine is a five-membered saturated aliphatic heterocycle with one nitrogen atom and four carbon atoms.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003023";
        skos:prefLabel   "N-acylpyrrolidines"@en .

CHEMONTID:0003963  rdf:type  skos:Concept;
        skos:altLabel    "organofluorine compound" , "organophosphorus compound";
