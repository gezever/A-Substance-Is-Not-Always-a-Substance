        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004539";
        skos:prefLabel   "Organothalium compounds"@en .

CHEMONTID:0002322  rdf:type  skos:Concept;
        skos:altLabel    "organic heterobicyclic compound" , "organonitrogen heterocyclic compound";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Heterocyclic aromatic compounds containing a triazole ring fused to a diazepine ring. Triazole is a five-membered ring consisting of two carbon atoms and three nitrogen atoms. Diazepine is a 7-membered ring consisting of five carbon and two nitrogen atoms.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002322";
        skos:prefLabel   "Triazolodiazepines"@en .

CHEMONTID:0001802  rdf:type  skos:Concept;
