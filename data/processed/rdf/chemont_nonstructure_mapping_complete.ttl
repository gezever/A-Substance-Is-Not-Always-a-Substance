        skos:broader     CHEMONTID:0002004;
        skos:definition  "Triquinane with a structure based on a [3.3.3] carbon skeleton.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003585";
        skos:prefLabel   "Propellane triquinanes"@en .

CHEMONTID:0002004  rdf:type  skos:Concept;
