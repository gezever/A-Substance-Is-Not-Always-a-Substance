        skos:definition  "Organic compounds containing an enolate bonded through its oxygen terminus to an organosilicon group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002053";
        skos:prefLabel   "Silyl enol ethers"@en .

CHEMONTID:0000952  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000447;
        skos:definition  "Inorganic compounds in which the largest oxoanion is arsenate, and in which the heaviest atom not in an oxoanion is a lanthanide.";
        skos:inScheme    conceptscheme:chemical_substance;
