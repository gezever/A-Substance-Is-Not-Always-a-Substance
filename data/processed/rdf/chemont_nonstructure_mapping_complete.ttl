        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001977";
        skos:prefLabel   "Pyrimidinylpiperazines"@en .

CHEMONTID:0000085  rdf:type  skos:Concept;
