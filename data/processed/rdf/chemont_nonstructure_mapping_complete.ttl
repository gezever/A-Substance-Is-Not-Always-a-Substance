        skos:altLabel    "Saccharolipids" , "lipopolysaccharide" , "lipid";
        skos:broader     CHEMONTID:0000012;
        skos:definition  "Compounds in which fatty acids are linked directly to a sugar backbone, forming structures that are compatible with membrane bilayers. In the saccharolipids, a sugar substitutes for the glycerol backbone that is present in glycerolipids and glycerophospholipids. The most familiar saccharolipids contain an acylated glucosamine. In contrast to others glycolipids, the fatty acid is not glycosidically linked to the sugar moiety.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0001522;
        skos:notation    "CHEMONTID:0003918";
        skos:prefLabel   "Saccharolipids"@en .

CHEMONTID:0002230  rdf:type  skos:Concept;
        skos:altLabel    "aliphatic aldehyde";
        skos:broader     CHEMONTID:0000124;
        skos:definition  "An aldehyde with a chain length containing between 2 and 5 carbon atoms.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002230";
        skos:prefLabel   "Short-chain aldehydes"@en .

CHEMONTID:0001968  rdf:type  skos:Concept;
        skos:altLabel    "lignan";
        skos:broader     CHEMONTID:0003424;
        skos:definition  "Lignan compounds containing a 3,4-dibenzyloxolan-2-ol moiety.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001968";
        skos:prefLabel   "Dibenzylbutyrolactols"@en .

CHEMONTID:0003424  rdf:type  skos:Concept;
        skos:altLabel    "3,4-dibenzyltetrahydrofuran lignans" , "lignan" , "9,9-Epoxytetrahydrofuranoid lignans";
        skos:broader     CHEMONTID:0001604;
        skos:definition  "Lignans with a structure based on the 9,9'-epoxylignan skeleton, which consists of a tetrahydrofuran that carries two benzyl groups at the 3- and 4-positions. Additionally they are oxygenated at the 2-position to form dibenzylbutyrolactones (oxo group) or a dibenzylbutyrolactols (hydroxyl group).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0001968 , CHEMONTID:0001613;
        skos:notation    "CHEMONTID:0003424";
        skos:prefLabel   "9,9'-epoxylignans"@en .

CHEMONTID:0002314  rdf:type  skos:Concept;
        skos:altLabel    "quinazolines";
        skos:broader     CHEMONTID:0000485;
        skos:definition  "Heterocyclic aromatic compounds containing a quianazoline moiety substituted by one or more amine groups.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002314";
        skos:prefLabel   "Quinazolinamines"@en .

CHEMONTID:0000319  rdf:type  skos:Concept;
        skos:altLabel    "oxacycle" , "organonitrogen heterocyclic compound";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Organic compounds containing a benzene fused to an oxazepine ring (a seven-membered ring with four carbon atoms, one oxygen atom, and a nitrogen atom).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0000150;
        skos:notation    "CHEMONTID:0000319";
        skos:prefLabel   "Benzoxazepines"@en .

CHEMONTID:0003005  rdf:type  skos:Concept;
        skos:altLabel    "a sulfated flavonoid";
        skos:broader     CHEMONTID:0000334;
        skos:definition  "Flavonoids that are sulfated at one or more positions.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004181;
        skos:notation    "CHEMONTID:0003005";
        skos:prefLabel   "Sulfated flavonoids"@en .

CHEMONTID:0003466  rdf:type  skos:Concept;
        skos:altLabel    "oxacycle";
        skos:broader     CHEMONTID:0000145;
        skos:definition  "Organic aromatic compounds that contain a p-dioxole ring that is angularly fused to the benzene ring of a coumarin. In p-dioxolo[2,3-h]coumarins, the coumarin ring system shares its C7-C8 bond with the p-dioxole ring.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003466";
        skos:prefLabel   "p-Dioxolo[2,3-h]coumarins"@en .

CHEMONTID:0002792  rdf:type  skos:Concept;
        skos:altLabel    "isoquinoline alkaloid";
        skos:broader     CHEMONTID:0000279;
        skos:definition  "Alkaloids with a structure based on the hasubanan skeleton, a tetracyclic propellane.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002792";
        skos:prefLabel   "Hasubanan alkaloids"@en .

CHEMONTID:0003134  rdf:type  skos:Concept;
        skos:altLabel    "carboxamide";
        skos:broader     CHEMONTID:0003132;
        skos:definition  "Organonitrogen compounds with the general formula RN(H)N(H)C(=O)N (R = organyl).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003134";
        skos:prefLabel   "Hydrazinecarboxamides"@en .

CHEMONTID:0003705  rdf:type  skos:Concept;
        skos:altLabel    "1-ribosylbenzimidazole";
        skos:broader     CHEMONTID:0003737;
        skos:definition  "Nucleoside and nucleotide analogs with a structure that consists of a benzimidazole ring system which is N-substituted at the 2-position with a ribose moiety. Nucleotide analogues contain a phosphate group linked to the C5 carbon atom of the furanose.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003705";
        skos:prefLabel   "2-ribofuranosylbenzimidazoles"@en .

CHEMONTID:0004624  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0002414;
        skos:definition  "Compounds containing a pyridine ring bearing a carboxylic acid group at the 2-position.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004626 , CHEMONTID:0004627;
        skos:notation    "CHEMONTID:0004624";
        skos:prefLabel   "Pyridine-2-carboxylic acids"@en .

CHEMONTID:0002986  rdf:type  skos:Concept;
        skos:altLabel    "3-oxo Delta(7)-steroid";
        skos:broader     CHEMONTID:0003026;
        skos:definition  "3-oxo steroids containing a double bond between positions 6 and 7.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002986";
        skos:prefLabel   "3-oxo delta-7-steroids"@en .

CHEMONTID:0000985  rdf:type  skos:Concept;
        skos:altLabel    "Inorganic Chemicals" , "p-block molecular entity" , "Metalloids";
        skos:broader     CHEMONTID:0000449;
        skos:definition  "Inorganic compounds in which the largest oxoanion is tetrahydroxyborate, and in which the heaviest atom not in an oxoanion is a metalloid.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000985";
        skos:prefLabel   "Metalloid tetrahydroxyborates"@en .

CHEMONTID:0000132  rdf:type  skos:Concept;
        skos:altLabel    "an enol";
        skos:broader     CHEMONTID:0000323;
        skos:definition  "Compounds containing the enol functional group, with the structure HO(R)C=CR'. Ketones that have one or more alpha-hydrogen atoms undergo keto-enol tautomerization, the tautomer being an enol.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000132";
        skos:prefLabel   "Enols"@en .

CHEMONTID:0001375  rdf:type  skos:Concept;
        skos:altLabel    "cyanohydrins" , "cyanohydrin";
        skos:broader     CHEMONTID:0000362;
        skos:definition  "Organic compounds containing the cyanohydrin functional group, -C(OH)CN.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001375";
        skos:prefLabel   "Cyanohydrins"@en .

CHEMONTID:0001791  rdf:type  skos:Concept;
        skos:altLabel    "pyrazinoindole" , "organic disulfide" , "a gliotoxin" , "organic heterotetracyclic compound";
        skos:broader     CHEMONTID:0001790;
        skos:definition  "Polycyclic compounds containing the gliotoxin skeleton, which is structurally characterized by a epipolythiodioxopiperazine moiety fused to the pyrrolidine ring of an indol-7-ol derivative.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001791";
        skos:prefLabel   "Gliotoxins"@en .

CHEMONTID:0001790  rdf:type  skos:Concept;
        skos:altLabel    "Epidithiodioxopiperazines" , "2,5-diketopiperazines" , "ETPs" , "an epipolythiodioxopiperazine" , "organic disulfide" , "indoles" , "organic heteropentacyclic compound";
        skos:broader     CHEMONTID:0001732;
        skos:definition  "Compounds containing an epipolythiodioxopiperazine moiety, which consists of a 2,3-dithia-5,7-diazabicyclo[2.2.2]octane-6,8-dione ring system. One distinct characteristics of Epipolythiodioxopiperazines is the presence of unique di- or polysulfide bridges.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0001791;
        skos:notation    "CHEMONTID:0001790";
        skos:prefLabel   "Epipolythiodioxopiperazines"@en .

CHEMONTID:0000179  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000178;
        skos:definition  "Compounds containing a hippuric acid or a derivative, with a structure characterized the presence of a benzoyl group linked to the N-terminal of a glycine.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0001318;
        skos:notation    "CHEMONTID:0000179";
        skos:prefLabel   "Hippuric acids and derivatives"@en .

CHEMONTID:0002589  rdf:type  skos:Concept;
        skos:altLabel    "4-methoxyflavonoids";
        skos:broader     CHEMONTID:0002585;
        skos:definition  "Flavonoids with methoxy groups attached to the C4 atom of the flavonoid backbone.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002589";
        skos:prefLabel   "4-O-methylated flavonoids"@en .

CHEMONTID:0001783  rdf:type  skos:Concept;
        skos:altLabel    "indole alkaloid";
        skos:broader     CHEMONTID:0000279;
        skos:definition  "Compounds containing the pentacyclic curan skeleton, which is structurally characterized by the presence of a pentacyclic 3,5-ethanopyrrolo[2,3-d]carbazole framework.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001783";
        skos:prefLabel   "Curan alkaloids"@en .

CHEMONTID:0001566  rdf:type  skos:Concept;
        skos:altLabel    "enyne";
        skos:broader     CHEMONTID:0004475;
        skos:definition  "Hydrocarbons containing an alkene and an alkyne group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001566";
        skos:prefLabel   "Enynes"@en .

CHEMONTID:0001178  rdf:type  skos:Concept;
