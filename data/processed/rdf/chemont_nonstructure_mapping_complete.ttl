        skos:definition  "Organosulfur compounds with the generic structure RC(SR')N([H])C=O, where R,R'= H or organyl group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004116";
        skos:prefLabel   "N,S-acetals"@en .

CHEMONTID:0003718  rdf:type  skos:Concept;
        skos:altLabel    "purines" , "nucleoside analogue";
        skos:broader     CHEMONTID:0003740;
        skos:definition  "Nucleoside analogues with a structure that consists of a cyclobutane that is substituted a the 1-position with a hydroxyl group and at the 3-position with either a purine base.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003718";
