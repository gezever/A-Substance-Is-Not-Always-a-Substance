CHEMONTID:0000612  rdf:type  skos:Concept;
        skos:altLabel    "actinoid molecular entity";
        skos:broader     CHEMONTID:0000448;
        skos:definition  "Inorganic compounds in which the largest oxoanion is peroxynitrate, and in which the heaviest atom not in an oxoanion is an actinide.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000612";
        skos:prefLabel   "Actinide peroxynitrites"@en .

CHEMONTID:0000720  rdf:type  skos:Concept;
        skos:altLabel    "p-block molecular entity";
        skos:broader     CHEMONTID:0000451;
        skos:definition  "Inorganic compounds in which the largest oxoanion is hyponitrite, and in which the heaviest atom not in an oxoanion is a post-transition metal.";
        skos:inScheme    conceptscheme:chemical_substance;
