        skos:broader     CHEMONTID:0000091;
        skos:definition  "Polycyclic aromatic compounds containing a benzene ring linked to a pyrroline ring through a CC or CN bond.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002335";
        skos:prefLabel   "Phenylpyrrolines"@en .

CHEMONTID:0003400  rdf:type  skos:Concept;
        skos:altLabel    "diterpenoid";
        skos:broader     CHEMONTID:0003401;
        skos:definition  "Diterpenoids with a structure characterized by a stemarane skeleton. Some characteristics include the bicyclic system C/D that is constituted by a bicyclo[3.2.1]octane fused to the bicyclic A/B system in a different fashion with respect to other tetracyclic diterpenes possessing the bicyclo[3.2.1]octane system. Moreover, the two contiguous quaternary carbon atoms,  C(9) and C(10), are present, the former being a spirocyclic atom. Oxygenation can happen at positions C(2), C(7), C(13), C(17), C(18), and C(19).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003400";
        skos:prefLabel   "Stemarane diterpenoids"@en .

CHEMONTID:0002830  rdf:type  skos:Concept;
        skos:altLabel    "5-hydroxyfuro[3,2-g]coumarins" , "Linear 5-hydroxyfurocoumarins" , "Linear 5-hydroxyfuranocoumarins" , "psoralens";
        skos:broader     CHEMONTID:0000202;
        skos:definition  "Psoralens containing a hydroxyl group attached at the C5 position of the psoralen group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002830";
        skos:prefLabel   "5-hydroxypsoralens"@en .

CHEMONTID:0000727  rdf:type  skos:Concept;
        skos:altLabel    "p-block molecular entity";
        skos:broader     CHEMONTID:0000451;
        skos:definition  "Inorganic compounds in which the largest oxoanion is perchlorate, and in which the heaviest atom not in an oxoanion is a post-transition metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000727";
        skos:prefLabel   "Post-transition metal perchlorates"@en .

CHEMONTID:0001836  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0002042;
        skos:definition  "Terphenyls with a structure containing the 1,2-diphenylbenzene skeleton.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001836";
        skos:prefLabel   "O-terphenyls"@en .

CHEMONTID:0001136  rdf:type  skos:Concept;
        skos:altLabel    "hydroxyflavan" , "Flavonols" , "3-hydroxyflavones";
        skos:broader     CHEMONTID:0001615;
        skos:definition  "Compounds that contain a flavone (2-phenyl-1-benzopyran-4-one) backbone carrying a hydroxyl group at the 3-position.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001136";
        skos:prefLabel   "Flavonols"@en .

CHEMONTID:0001462  rdf:type  skos:Concept;
        skos:altLabel    "glycolipid";
        skos:broader     CHEMONTID:0001766;
        skos:definition  "Lipids containing a mannosylerylthritol skeleton, which is 1-O-b-mannopyranosyl-meso-erythritol.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001462";
        skos:prefLabel   "Mannosylerythritol lipids"@en .

CHEMONTID:0003428  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0003916;
        skos:definition  "Stemona alkaloids with a structure containing a pyrrolo[1,2-a]azepine group, where the azepine moiety forms a spiro system with oxolane-5-one to give spiro[oxolane-2,9'-pyrrolo[1,2-a]azepine]-5-one. Moreover, another 5-oxooxolane moiety attached to the pyrrole ring.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003428";
        skos:prefLabel   "Croomine-type alkaloids"@en .

CHEMONTID:0002905  rdf:type  skos:Concept;
