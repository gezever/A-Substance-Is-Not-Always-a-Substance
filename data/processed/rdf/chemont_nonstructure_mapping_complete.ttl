        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002166";
        skos:prefLabel   "Pyrimidine 2',3'-dideoxyribonucleoside monophosphates"@en .

CHEMONTID:0002151  rdf:type  skos:Concept;
        skos:altLabel    "pyrimidine nucleoside monophosphate";
        skos:broader     CHEMONTID:0002148;
        skos:definition  "Pyrimidine ribobucleotides with one monophosphate group attached to one hydroxyl group of the ribose moiety, which lacks a hydroxyl group at one or more positions.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0002166 , CHEMONTID:0002159 , CHEMONTID:0002158;
        skos:notation    "CHEMONTID:0002151";
        skos:prefLabel   "Pyrimidine deoxyribonucleoside monophosphates"@en .

CHEMONTID:0002882  rdf:type  skos:Concept;
        skos:altLabel    "sesterterpenoid";
        skos:broader     CHEMONTID:0001552;
        skos:definition  "Sesterterpnoids with a structure based on the ophiobolane backbone. Ophiobolane is a tricyclic compound consisting of two cyclopentane rings joined by a cyclooctane ring, and carries a methyl group at the 1-, 4-, and 8-position, as well as a 6-methylheptane group at the 12-position.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002882";
        skos:prefLabel   "Ophiobolane sesterterpenoids"@en .

CHEMONTID:0000793  rdf:type  skos:Concept;
        skos:altLabel    "Inorganic Chemicals" , "p-block element atom" , "Metalloids";
        skos:broader     CHEMONTID:0000449;
        skos:definition  "Inorganic compounds in which the largest oxoanion is chromate, and in which the heaviest atom is a metalloid.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000793";
        skos:prefLabel   "Metalloid chromates"@en .

CHEMONTID:0002903  rdf:type  skos:Concept;
        skos:altLabel    "naphthalenone" , "a perylenequinone";
        skos:broader     CHEMONTID:0002448;
        skos:definition  "Heterocyclic compounds characterized by  two 8-hydroxy-1,4-dihydronaphthalen-1-one moieties joined together one or two CC-bonds.";
        skos:inScheme    conceptscheme:chemical_substance;
