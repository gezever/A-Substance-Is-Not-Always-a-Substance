        skos:prefLabel   "Transition metal chromites"@en .

CHEMONTID:0002549  rdf:type  skos:Concept;
        skos:altLabel    "steroid";
        skos:broader     CHEMONTID:0002382;
        skos:definition  "Oxasteroids with a structure containing an C-17 steroid skeleton, with two oxygen atoms replacing carbon atoms, and one C=O group. They all have one nitrogen atom at the 15-position. Some tanshinlactones have the second oxygen atom at the 11-position and a C=O group at the 12-position. Others have the second oxygen atom at the 12-position and a C=O group at the 11-position.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002549";
        skos:prefLabel   "Tanshinlactones and derivatives"@en .

CHEMONTID:0002382  rdf:type  skos:Concept;
        skos:altLabel    "oxa-steroid";
        skos:broader     CHEMONTID:0000258;
        skos:definition  "Steroid derivatives where a carbon atom of the steroid is replaced by an oxygen atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0002549;
        skos:notation    "CHEMONTID:0002382";
        skos:prefLabel   "Oxasteroids and derivatives"@en .

CHEMONTID:0000681  rdf:type  skos:Concept;
        skos:altLabel    "alkaline earth salt";
        skos:broader     CHEMONTID:0000446;
        skos:definition  "Inorganic compounds in which the largest oxoanion is hypophosphite, and in which the heaviest atom not in an oxoanion is an alkaline earth metal.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000681";
        skos:prefLabel   "Alkaline earth metal hypophosphites"@en .

