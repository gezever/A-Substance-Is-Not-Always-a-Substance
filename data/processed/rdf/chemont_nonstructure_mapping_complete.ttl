        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002024";
        skos:prefLabel   "N,N'-diacyl ureas"@en .

CHEMONTID:0001929  rdf:type  skos:Concept;
        skos:altLabel    "organosulfur heterocyclic compound" , "organonitrogen heterocyclic compound";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Heterocyclic compounds containing a thiophene ring fused to a thiazole. Thiophene is 5-membered ring consisting of four carbon atoms and one sulfur atom. Thiazole is a 6-membered ring that contains both sulfur and nitrogen.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001929";
        skos:prefLabel   "Thienothiazoles"@en .

CHEMONTID:0002607  rdf:type  skos:Concept;
        skos:altLabel    "organobromine compound" , "alcohol";
        skos:broader     CHEMONTID:0002528;
        skos:definition  "Alcohols substituted by a bromine atom at a saturated carbon atom otherwise bearing only hydrogen or hydrocarbyl groups.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002607";
        skos:prefLabel   "Bromohydrins"@en .
