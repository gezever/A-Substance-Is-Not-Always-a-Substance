        skos:definition  "Organic compounds containing 1,3-dioxole, an aliphatic five-member ring with two oxygen atoms in ring positions 1 and 3 and a double bond.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0000272";
        skos:prefLabel   "1,3-dioxoles"@en .

CHEMONTID:0002828  rdf:type  skos:Concept;
        skos:altLabel    "organic heterotetracyclic compound" , "organonitrogen heterocyclic compound";
        skos:broader     CHEMONTID:0001762;
        skos:definition  "Organic heterocyclic compounds with a structure based on the Pyrrolo[2,3,4-kl]acridine skeleton.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002828";
