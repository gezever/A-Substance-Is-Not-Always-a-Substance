CHEMONTID:0001443  rdf:type  skos:Concept;
        skos:altLabel    "triazolopyrimidines";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Polycyclic aromatic compounds containing triazole ring fused to a pyrimidine ring. Triazole is a five-membered ring consisting of two carbon atoms and three nitrogen atoms. Pyrimidine is a 6-membered ring consisting of four carbon atoms and two nitrogen centers at the 1- and 3- ring positions.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004681;
        skos:notation    "CHEMONTID:0001443";
        skos:prefLabel   "Triazolopyrimidines"@en .

CHEMONTID:0000311  rdf:type  skos:Concept;
        skos:altLabel    "benzothiazoles";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Organic compounds containing a benzene fused to a thiazole ring (a five-membered ring with four carbon atoms, one nitrogen atom and one sulfur atom).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0004332;
        skos:notation    "CHEMONTID:0000311";
        skos:prefLabel   "Benzothiazoles"@en .

CHEMONTID:0000725  rdf:type  skos:Concept;
        skos:altLabel    "p-block molecular entity";
        skos:broader     CHEMONTID:0000451;
