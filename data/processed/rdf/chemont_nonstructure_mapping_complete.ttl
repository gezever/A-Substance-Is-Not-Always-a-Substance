CHEMONTID:0004216  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0000075;
        skos:definition  "Aromatic heterocyclic compounds containing an anilinopyrimidine skeleton, which consists of an aniline that is N-substituted by a pyrimidine.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004216";
        skos:prefLabel   "Anilinopyrimidines"@en .

CHEMONTID:0004824  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0003056;
        skos:definition  "Azasteroids that are characterized by an androstane skeleton, where the carbon atom at the 4-position has been replaced by a nitrogen atom.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004824";
        skos:prefLabel   "4-azaandrostanes"@en .

CHEMONTID:0001467  rdf:type  skos:Concept;
        skos:altLabel    "3-hydroxy steroid";
        skos:broader     CHEMONTID:0003568;
        skos:definition  "3-hydroxylated C19 steroid hormones. They are known to favor the development of masculine characteristics. They also show profound effects on scalp and body hair in humans.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001467";
        skos:prefLabel   "Androgens and derivatives"@en .

CHEMONTID:0001304  rdf:type  skos:Concept;
        skos:altLabel    "ciguatoxin";
        skos:broader     CHEMONTID:0000261;
        skos:definition  "A group of cyclic polyether compounds produced naturally by a species of dinoflagellate known as Karenia brevis. They contain a Pentaoxapentacycloheptacos- 23-en-7-one derivative (type a brevetoxin) or a pentaoxapentacyclotetracosa- 8,23-dien-7-one derivative (type b brevetoxin).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001304";
        skos:prefLabel   "Brevetoxins and derivatives"@en .

CHEMONTID:0002375  rdf:type  skos:Concept;
        skos:altLabel    "ketimine";
        skos:broader     CHEMONTID:0001673;
        skos:definition  "Ketimines where the nitrogen of the ketimine group is linked to an alkyl or aryl group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002375";
        skos:prefLabel   "Secondary ketimines"@en .

CHEMONTID:0002662  rdf:type  skos:Concept;
        skos:altLabel    "Type B colchicaceae alkaloids";
        skos:broader     CHEMONTID:0000279;
        skos:definition  "Analogues of proaporphines with the difference that the spirocyclohexenol ring is joined to a cyclohexane instead of a cyclopentane.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002662";
        skos:prefLabel   "Homoproaporphines"@en .

CHEMONTID:0002356  rdf:type  skos:Concept;
        skos:altLabel    "2,5-diketopiperazines" , "Piperazinediones" , "Dioxopiperazines";
        skos:broader     CHEMONTID:0001995;
        skos:definition  "Organic compounds containing a piperazine ring in which the two nitrogen atoms are part of amide linkages.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0002356";
        skos:prefLabel   "Diketopiperazines"@en .

CHEMONTID:0004142  rdf:type  skos:Concept;
        skos:broader     CHEMONTID:0002871;
        skos:definition  "Grayanoids containing a B-homo-C-nor grayanane skeleton or a 1,5-derivative thereof.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004142";
        skos:prefLabel   "Kalmanes and 1,5-seco-kalmanes"@en .

CHEMONTID:0004187  rdf:type  skos:Concept;
        skos:altLabel    "Phorbins" , "phorbines";
        skos:broader     CHEMONTID:0001455;
