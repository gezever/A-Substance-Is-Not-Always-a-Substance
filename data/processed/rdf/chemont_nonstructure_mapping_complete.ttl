        skos:definition  "Esters of sulfonic acid, which have the general structure RS(=O)2OR' (R,R' = organyl group or H).";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0004435";
        skos:prefLabel   "Sulfonic acid esters"@en .

CHEMONTID:0004551  rdf:type  skos:Concept;
        skos:altLabel    "(trifluoromethyl)benzenes";
        skos:broader     CHEMONTID:0002279;
