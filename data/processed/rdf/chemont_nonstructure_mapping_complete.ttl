        skos:narrower    CHEMONTID:0001544 , CHEMONTID:0001293 , CHEMONTID:0002134 , CHEMONTID:0001491;
        skos:notation    "CHEMONTID:0001506";
        skos:prefLabel   "Purine nucleotides"@en .

CHEMONTID:0003068  rdf:type  skos:Concept;
        skos:altLabel    "N-oxide";
        skos:broader     CHEMONTID:0000496;
        skos:definition  "Amine oxides where the N atom is monosubstituted with one organic group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0003068";
        skos:prefLabel   "Monosubstituted amine oxides and derivatives"@en .

CHEMONTID:0000496  rdf:type  skos:Concept;
        skos:altLabel    "N-oxide" , "amine oxides" , "N-substituted amine";
        skos:broader     CHEMONTID:0002449;
        skos:definition  "Organic compounds that contains the amine oxide functional group with the formula R3N+-O-, which substituted by at least one organic group.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0003068 , CHEMONTID:0003069 , CHEMONTID:0003070;
        skos:notation    "CHEMONTID:0000496";
        skos:prefLabel   "Amine oxides and derivatives"@en .

CHEMONTID:0001401  rdf:type  skos:Concept;
        skos:altLabel    "p-menthane monoterpenoid" , "Menthane monoterpenoids";
        skos:broader     CHEMONTID:0001549;
        skos:definition  "Monoterpenoids with a structure based on the o-, m-, or p-menthane backbone. P-menthane consists of the cyclohexane ring with a methyl group and a (2-methyl)-propyl group at the 1 and 4 ring position, respectively. The o- and m- menthanes are much rarer, and presumably arise by alkyl migration of p-menthanes.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:notation    "CHEMONTID:0001401";
        skos:prefLabel   "Menthane monoterpenoids"@en .

CHEMONTID:0000094  rdf:type  skos:Concept;
        skos:altLabel    "thiazine";
        skos:broader     CHEMONTID:0000002;
        skos:definition  "Heterocyclic compounds containing an aliphatic unsaturated six-member ring with four carbon atoms, one sulfur atom, and one nitrogen. Isomers include 1,2-thiazines, 1,3-thiazines, and 1,4-thiazines.";
        skos:inScheme    conceptscheme:chemical_substance;
        skos:narrower    CHEMONTID:0001349 , CHEMONTID:0001347 , CHEMONTID:0001348;
        skos:notation    "CHEMONTID:0000094";
        skos:prefLabel   "Thiazines"@en .

CHEMONTID:0002918  rdf:type  skos:Concept;
        skos:altLabel    "Serratane and onocerane triterpenoids";
