        obo:IAO_0000115             "An alkane-α,ω-diamine comprising a straight-chain pentane core with amino substitutents at positions 1 and 5. A colourless syrupy liquid diamine with a distinctive unpleasant odour, it is a homologue of putresceine and is formed by the bacterial decarboxylation of lysine that occurs during protein hydrolysis during putrefaction of animal tissue. It is also found in plants such as soyabean.";
        oboInOwl:hasAlternativeId   "CHEBI:13928" , "CHEBI:22974" , "CHEBI:44370" , "CHEBI:3288";
        oboInOwl:hasDbXref          "pdb-ccd:N2P" , "pubmed:23561112" , "pubmed:16668466" , "metacyc.compound:CADAVERINE" , "pubmed:23794626" , "pubmed:10930630" , "reaxys:1697256" , "pubmed:16346523" , "pubmed:23887488" , "pubmed:17439666" , "kegg.compound:C01672" , "cas:462-94-2" , "pubmed:11397445" , "hmdb:HMDB0002322" , "gmelin:2310" , "drugbank:DB03854" , "pubmed:11517436" , "pubmed:23811038" , "knapsack:C00001403" , "wikipedia.en:Cadaverine";
