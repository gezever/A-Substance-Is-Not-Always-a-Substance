obo:CHEBI_77822  rdf:type           owl:Class;
        rdfs:label                  "dextilidine";
        rdfs:subClassOf             obo:CHEBI_22712 , obo:CHEBI_50860 , obo:CHEBI_77817;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        obo:IAO_0000115             "An ethyl 2-(dimethylamino)-1-phenylcyclohex-3-ene-1-carboxylate that has <i>S</i> configuration at the carbon bearing the phenyl group and <i>R</i> configuration at the carbon bearing the dimethylamino group. The opioid analgesic tilidine is the racemate comprising equimolar amounts of dextilidine and its enantiomer, <em>ent</em>-dextilidine. A prodrug, tilidine is converted by the liver to the active analgesic, nortilidine; virtually all of the opioid activity resides in the (1<i>S</i>,2<i>R</i>) isomer (i.e. the isomer derived from dextilidine).";
        oboInOwl:hasDbXref          "cas:32447-90-8";
        oboInOwl:hasExactSynonym    "ethyl (1S,2R)-2-(dimethylamino)-1-phenylcyclohex-3-ene-1-carboxylate";
        oboInOwl:hasOBONamespace    "chebi_ontology";
        oboInOwl:hasRelatedSynonym  "(+)-ethyl trans-2-(dimethylamino)-1-phenyl-3-cyclohexene-1-carboxylate" , "(1S,2R)-(+)-ethyl-2-dimethylamino-1-phenyl-3-cyclohexen-1-carboxylate" , "ethyl (1S,2R)-2-(dimethylamino)-1-phenylcyclohex-3-ene-1-carboxylate" , "dextilidinum" , "dextilidine" , "(+)-(1S,2R)-ethyl-2-dimethylamino-1-phenyl-3-cyclohexen-1-carboxylate" , "dextilidina";
        oboInOwl:id                 "CHEBI:77822";
        oboInOwl:inSubset           chebi:3_STAR;
        chemrof:charge              0;
        chemrof:generalized_empirical_formula
                "C17H23NO2";
        chemrof:inchi_key_string    "WDEFBBTXULIOBB-WBVHZDCISA-N";
