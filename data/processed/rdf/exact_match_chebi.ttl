        obo:IAO_0000115             "An elemental molecule with formula O<small><sub>3</sub></small>. An explosive, pale blue gas (b.p. −112°C) that has a characteristic, pungent odour, it is continuously produced in the upper atmosphere by the action of solar ultraviolet radiation on atmospheric oxygen. It is an antimicrobial agent used in the production of bottled water, as well as in the treatment of meat, poultry and other foodstuffs.";
        oboInOwl:hasDbXref          "hmdb:HMDB0035409" , "pubmed:7763188" , "cas:10028-15-6" , "pubmed:24176344" , "pubmed:11029342" , "pubmed:15963550" , "pubmed:23517299" , "pubmed:8255146" , "molbase:931" , "pubmed:19519548" , "pubmed:10226494" , "pubmed:19580672" , "pubmed:11203434" , "pubmed:17674823" , "pubmed:20477724" , "pubmed:11568152" , "pubmed:19723209" , "reaxys:4921393" , "pubmed:1717074" , "pubmed:19827485" , "pubmed:18250191" , "pubmed:10205911" , "pubmed:9202716" , "pubmed:18699586" , "pubmed:23501341" , "pubmed:10552743" , "wikipedia.en:Ozone" , "pubmed:23556239" , "gmelin:1101" , "pubmed:23488636" , "pubmed:12509241" , "pubmed:24188305" , "pubmed:24001808" , "pubmed:15598576";
