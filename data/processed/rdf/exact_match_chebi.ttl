        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        obo:IAO_0000115             "An aminopyrimidine that is 2-methylpyrimidine which is substituted at position 4 by the primary amino group of 2-amino-1,3-thiazole-5-carboxylic acid and at position 6 by a 4-(2-hydroxyethyl)piperazin-1-yl group, and in which the carboxylic acid group has been formally condensed with 2-chloro-6-methylaniline to afford the corresponding amide. A multi-targeted kinase inhibitor, it is used, particularly as the monohydrate, for the treatment of chronic, accelerated, or myeloid or lymphoid blast phase chronic myeloid leukemia. Note that the name 'dasatinib' is used to refer to the monohydrate (USAN) as well as to anhydrous dasatinib (INN).";
        oboInOwl:hasAlternativeId   "CHEBI:38943" , "CHEBI:49372";
        oboInOwl:hasDbXref          "hmdb:HMDB0015384" , "patent:WO2010067374" , "patent:US7941725" , "patent:US7125875" , "pubmed:18020922" , "drugbank:DB01254" , "pubmed:22992064" , "pubmed:18797457" , "pubmed:22411867" , "drugcentral:785" , "pubmed:17154512" , "wikipedia.en:Dasatinib" , "pubmed:19494352" , "pdb-ccd:1N1" , "pubmed:19640584" , "pubmed:21226671" , "pubmed:18823558" , "patent:WO2010139979" , "lincs.smallmolecule:LSM-1020" , "pubmed:19502192" , "pubmed:23065516" , "reaxys:9966762" , "pubmed:18784745" , "kegg.drug:D03658" , "pubmed:16775234" , "cas:302962-49-8" , "pubmed:22740998";
