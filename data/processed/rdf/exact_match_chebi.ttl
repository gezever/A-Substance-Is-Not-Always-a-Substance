obo:CHEBI_90075  rdf:type           owl:Class;
        rdfs:label                  "rose oxide";
        rdfs:subClassOf             obo:CHEBI_46942 , obo:CHEBI_78840 , obo:CHEBI_25409;
        rdfs:subClassOf             [] ;
        obo:IAO_0000115             "A member of the class of oxanes that is  tetrahydro-2<em>H</em>-pyran which is substituted at positions 2 and 4 by an isoprop-1-enyl group and a methyl group, respectively. Organic compound of the pyran class and the monoterpene class and a fragrance found in roses and rose oil. All four possible stereoisomers are known; the 2<i>S</i>,4<i>R</i> and 2<i>S</i>,4<i>S</i> diastereoisomers [also known as the (−)-<i>cis</i>- and (−)-<i>trans</i>-isomers, respectively] are the main constituents in several essential oils and are used as a food flavouring and in perfumes and cosmetics.";
        oboInOwl:hasDbXref          "agr:IND44599794" , "pubmed:23122727" , "cas:16409-43-1" , "hmdb:HMDB0036097" , "wikipedia.en:Rose_oxide" , "agr:IND21967175" , "reaxys:111348" , "patent:EP0842926" , "pubmed:10564036" , "pubmed:25911965" , "pubmed:26126958" , "patent:WO0117983" , "pubmed:24518327" , "pubmed:18247534" , "pubmed:25212332";
