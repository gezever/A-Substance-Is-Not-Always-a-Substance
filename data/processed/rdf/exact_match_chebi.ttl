obo:CHEBI_49375  rdf:type           owl:Class;
        rdfs:label                  "dasatinib (anhydrous)";
        rdfs:subClassOf             obo:CHEBI_46851 , obo:CHEBI_38338 , obo:CHEBI_50860 , obo:CHEBI_46848 , obo:CHEBI_29347 , obo:CHEBI_50995 , obo:CHEBI_50996 , obo:CHEBI_36683 , obo:CHEBI_38418 , obo:CHEBI_62733;
