obo:CHEBI_39585  rdf:type           owl:Class;
        rdfs:label                  "carbidopa (anhydrous)";
        rdfs:subClassOf             obo:CHEBI_22712 , obo:CHEBI_50860 , obo:CHEBI_33566 , obo:CHEBI_25384 , obo:CHEBI_24631;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        obo:IAO_0000115             "3-(3,4-Dihydroxyphenyl)propanoic acid in which the hydrogens α- to the carboxyl group are substituted by hydrazinyl and methyl groups (<i>S</i>-configuration). Carbidopa is a dopa decarboxylase inhibitor, so prevents conversion of levodopa to dopamine. It has no antiparkinson activity by itself, but is used (commonly as its hydrate) in the management of Parkinson's disease to reduce peripheral adverse effects of levodopa.";
        oboInOwl:hasDbXref          "wikipedia.en:Carbidopa" , "drugbank:DB00190" , "cas:28860-95-9" , "pdb-ccd:142" , "beilstein:4189448" , "lincs.smallmolecule:LSM-5850" , "drugcentral:496";
