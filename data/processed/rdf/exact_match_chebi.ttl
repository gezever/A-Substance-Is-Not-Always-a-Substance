        chemrof:generalized_empirical_formula
                "C10H10O2";
        chemrof:inchi_key_string    "ZMQAAUBTXCXRIC-UHFFFAOYSA-N";
        chemrof:inchi_string        "InChI=1S/C10H10O2/c1-2-3-8-4-5-9-10(6-8)12-7-11-9/h2,4-6H,1,3,7H2";
        chemrof:mass                162.188;
        chemrof:monoisotopic_mass   162.06808;
