        obo:IAO_0000115             "A dithiocarbamic ester that is 1,3,5-thiadiazinane with a thione moiety at position 2 and in which the hydrogens attached to the nitrogens are replaced by methyl groups. A fungicide, herbicide and nematicide, it is used prior to sowing or planting for the control of soil fungi, nematodes, bacteria and germinating weeds, and as fumigant for poultry litter and eggs to control <em>Salmonella</em>. It is a non-ozone-depleting alternative to methyl bromide.";
        oboInOwl:hasDbXref          "pubmed:22522815" , "agr:IND89053727" , "pubmed:22228481" , "pubmed:786239" , "pubmed:18399425" , "agr:IND43742540" , "reaxys:116039" , "pubmed:4736772" , "cas:533-74-4" , "agr:IND44217344" , "ppdb:203" , "agr:IND90028778" , "kegg.compound:C18457";
