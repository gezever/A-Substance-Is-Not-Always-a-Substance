obo:CHEBI_133237  rdf:type          owl:Class;
        rdfs:label                  "indaziflam";
        rdfs:subClassOf             obo:CHEBI_60915;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        obo:IAO_0000115             "A diastereoisomeric mixture of the two fluoroethyl diastereoisomers of <em>N</em>-(2,6-dimethylindan-1-yl)-6-(1-fluoroethyl)-1,3,5-triazine-2,4-diamine in which the indane moiety has 1<i>R</i>,2<i>S</i> configuration. A cellulose biosynthesis inhibitor, it is used as a pre-emergence herbicide for the control of annual grasses and broad-leaved weeds in citrus, grapes, fruit trees, Christmas tree farms, lawns and sports fields. The two diastereoisomers have very similar biological activity; commercial material is a 95:5 mixture of the (1<i>R</i>,2<i>S</i>,fluoroethyl-<i>R</i>) and (1<i>R</i>,2<i>S</i>,fluoroethyl-<i>S</i>) diastereoisomers.";
        oboInOwl:hasDbXref          "agr:IND601311661" , "pesticides:indaziflam" , "pubmed:25190558" , "pubmed:25077797" , "agr:IND44616460" , "cas:950782-86-2" , "agr:IND601311803" , "pubmed:25950921" , "agr:IND601311638" , "agr:IND601309677" , "agr:IND604817664" , "agr:IND601311692" , "pubmed:27108479" , "agr:IND601311770" , "ppdb:1663" , "agr:IND604817642" , "reaxys:20920435";
