        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        rdfs:subClassOf             [] ;
        obo:IAO_0000115             "A racemate comprising equimolar amounts of (<i>R</i>)-(+)- and (<i>S</i>)-(−)-5-benzoyl-2,3-dihydro-1<em>H</em>-pyrrolizine-1-carboxylic acid. While only the (<i>S</i>)-(−) enantiomer is a COX1 and COX2 inhibitor, the (<i>R</i>)-(+) enantiomer exhibits potent analgesic activity. A non-steroidal anti-inflammatory drug, ketorolac is mainly used (generally as the tromethamine salt) for its potent analgesic properties in the short-term management of post-operative pain, and in eye drops to relieve the ocular itching associated with seasonal allergic conjunctivitis. It was withdrawn from the market in many countries in 1993 following association with haemorrhage and renal failure.";
        oboInOwl:hasDbXref          "pubmed:23088994" , "pubmed:17456651" , "wikipedia.en:Ketorolac" , "pubmed:23702435" , "pubmed:23298250" , "pubmed:23562034" , "pubmed:24022643" , "pubmed:10027870" , "kegg.compound:C07062" , "pubmed:22191998" , "hmdb:HMDB0014608" , "pubmed:23653032" , "pubmed:23447046" , "drugbank:DB00465" , "pubmed:10223774" , "reaxys:413572" , "pubmed:23179562" , "cas:74103-06-3" , "pubmed:10593468" , "pubmed:28166217" , "pubmed:23126437" , "patent:US4089969" , "pubmed:24112670" , "pubmed:9549656" , "pubmed:23473380" , "patent:US4347186" , "patent:BE856681" , "kegg.drug:D08104" , "pubmed:19281996";
