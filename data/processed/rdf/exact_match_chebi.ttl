        chemrof:mass                273.376;
        chemrof:monoisotopic_mass   273.17288;
        chemrof:smiles_string       "CCOC(=O)[C@]1(c2ccccc2)CCC=C[C@H]1N(C)C" .

csc:53cc3717913db2b3223d9f231945878c
        skos:exactMatch  obo:CHEBI_77822;
        skos:note        "An ethyl 2-(dimethylamino)-1-phenylcyclohex-3-ene-1-carboxylate that has <i>S</i> configuration at the carbon bearing the phenyl group and <i>R</i> configuration at the carbon bearing the dimethylamino group. The opioid analgesic tilidine is the racemate comprising equimolar amounts of dextilidine and its enantiomer, <em>ent</em>-dextilidine. A prodrug, tilidine is converted by the liver to the active analgesic, nortilidine; virtually all of the opioid activity resides in the (1<i>S</i>,2<i>R</i>) isomer (i.e. the isomer derived from dextilidine)."@en .

