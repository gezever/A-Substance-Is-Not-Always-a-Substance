        obo:IAO_0000115             "An aminoalkylpyridine that is pyridine substituted by a 2-(methylamino)ethyl group at position 2. It acts as a histamine agonist and a vasodilator, and is thought to improve the microcirculation of the labyrinth, resulting in reduced endolymphatic pressure. It is used (generally as the hydrochloride or mesylate salt) to reduce the symptoms of vertigo, tinnitus, and hearing loss associated with Ménière's disease.";
        oboInOwl:hasDbXref          "pubmed:22745706" , "drugcentral:346" , "kegg.drug:D07522" , "cas:5638-76-6" , "pubmed:7589314" , "pubmed:20530654" , "wikipedia.en:Betahistine" , "lincs.smallmolecule:LSM-4044" , "hmdb:HMDB0015644" , "pubmed:22365373" , "drugbank:DB06698" , "reaxys:112294";
