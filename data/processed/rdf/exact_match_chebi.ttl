obo:CHEBI_4024  rdf:type            owl:Class;
        rdfs:label                  "cyclopentolate";
        rdfs:subClassOf             obo:CHEBI_26878 , obo:CHEBI_50860 , obo:CHEBI_50996 , obo:CHEBI_33308 , obo:CHEBI_60911;
        rdfs:subClassOf             [] ;
