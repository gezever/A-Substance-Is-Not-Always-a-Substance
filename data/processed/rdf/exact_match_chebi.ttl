obo:CHEBI_6909  rdf:type            owl:Class;
        rdfs:label                  "metronidazole";
        rdfs:subClassOf             obo:CHEBI_15734 , obo:CHEBI_24780 , obo:CHEBI_50860 , obo:CHEBI_35716;
        rdfs:subClassOf             [] ;
