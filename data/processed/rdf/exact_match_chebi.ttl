        rdfs:subClassOf             [] ;
        obo:IAO_0000115             "A carboxamide resulting from the formal condensation of the carboxylic acid group of 3-bromo-1-(3-chloropyridin-2-yl)-1<em>H</em>-pyrazole-5-carboxylic acid with the primary amino group of 2-amino-5-chloro-<em>N</em>,3-dimethylbenzamide. The first of the anthranilic diamide insecticides, it is a <a href=\"https://en.wikipedia.org/wiki/Ryanodine_receptor\" target=\"_blank\">ryanodine receptor</a> activator and is used to protect a wide variety of crops, including corn, cotton, grapes, rice and potatoes.";
        oboInOwl:hasDbXref          "pubmed:22812143" , "reaxys:11247880" , "kegg.compound:C18454" , "pubmed:22076820" , "cas:500008-45-7" , "ppdb:1138" , "pubmed:22527463" , "pubmed:22856329";
